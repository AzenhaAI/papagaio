---
// The compact row: five platforms as icon buttons, no words to read.
//
// The card strip further down explains each door; this is for the person who
// already knows which one they want and should not have to scroll for it.
const base = '/papagaio';

const buttons = [
  { icon: '✈️', title: 'Telegram bot', href: 'https://t.me/papagaio_ebot', wide: true, label: 'Bot' },
  { icon: '🌍', title: 'Open in the browser', href: `${base}/translate/`, wide: true, label: 'Web' },
  { icon: '🍎', title: 'iPhone & iPad', href: `${base}/apps/` },
  { icon: '🤖', title: 'Android APK', href: '/dl/PapaGaio.apk' },
  { icon: '💻', title: 'macOS', href: '/dl/PapaGaio-mac.dmg' },
  { icon: '🪟', title: 'Windows', href: '/dl/PapaGaio-windows.zip' },
  { icon: '🧩', title: 'Chrome extension', href: '/dl/PapaGaio-chrome.zip' },
];
---
<div class="getapp">
  {buttons.map((b) => (
    <a class={b.wide ? 'gb wide' : 'gb'} href={b.href} title={b.title} aria-label={b.title}>
      <span>{b.icon}</span>{b.wide && <em>{b.label}</em>}
    </a>
  ))}
</div>

<style>
  .getapp { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 4px; }
  .gb { display: inline-flex; align-items: center; gap: 7px; text-decoration: none;
    background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
    padding: 8px 11px; font-size: 17px; line-height: 1;
    transition: border-color .15s ease, background .15s ease; }
  .gb:hover { border-color: var(--accent); background: var(--panel2, var(--panel)); }
  .gb em { font-style: normal; font-size: 13.5px; color: var(--text); font-weight: 600; }
</style>
