---
// Every door into PapaGaio, in one strip.
//
// The product lives in seven places and each page mentioned whichever one it
// happened to be about — someone reading the translator page had no idea the
// bot existed, and the browser panel was invisible unless you went looking.
// The doors are written out one by one rather than mapped from a list, so
// that each line carries its own [data-th] id (scripts/check_l10n.mjs reads
// the ids from the source).
const base = '/papagaio';
---
<section class="everywhere">
  <h2 data-th="everywhere.title">PapaGaio, wherever you read</h2>
  <p class="muted" style="max-width:640px; margin-top:-6px;" data-th="everywhere.lead">
    Same account across all of them — the bot's <code>/link</code> code pairs a
    device, and your deck follows.
  </p>
  <div class="doors">
    <a class="door" href={`${base}/translate/`}>
      <span class="ic">🌍</span>
      <span>
        <strong data-th="everywhere.browser">In the browser</strong>
        <small data-th="everywhere.browser-line">Nothing to install</small>
      </span>
    </a>
    <a class="door" href="https://apps.apple.com/app/papagaio-portugal/id6802084974">
      <span class="ic">📱</span>
      <span>
        <strong data-th="everywhere.ios">iPhone &amp; iPad</strong>
        <small data-th="everywhere.ios-line">On the App Store</small>
      </span>
    </a>
    <a class="door" href="https://play.google.com/store/apps/details?id=ai.azenha.papagaio">
      <span class="ic">🤖</span>
      <span>
        <strong>Android</strong>
        <small data-th="everywhere.android-line">On Google Play</small>
      </span>
    </a>
    <a class="door" href="/dl/PapaGaio-mac.dmg">
      <span class="ic">💻</span>
      <span>
        <strong>macOS</strong>
        <small data-th="everywhere.mac-line">Disk image, 22 MB</small>
      </span>
    </a>
    <a class="door" href="/dl/PapaGaio-windows.zip">
      <span class="ic">🪟</span>
      <span>
        <strong>Windows</strong>
        <small data-th="everywhere.win-line">Zip, 19 MB</small>
      </span>
    </a>
    <a class="door" href="https://t.me/papagaio_ebot">
      <span class="ic">✈️</span>
      <span>
        <strong data-th="everywhere.telegram">Telegram bot</strong>
        <small data-th="everywhere.telegram-line">Cards and voice in chat</small>
      </span>
    </a>
    <a class="door" href="/dl/PapaGaio-chrome.zip">
      <span class="ic">🧩</span>
      <span>
        <strong>Chrome</strong>
        <small data-th="everywhere.chrome-line">Select a word, read it in place</small>
      </span>
    </a>
    <a class="door" href={`${base}/features/`}>
      <span class="ic">🧭</span>
      <span>
        <strong>Safari</strong>
        <small data-th="everywhere.safari-line">Comes inside the iPhone app</small>
      </span>
    </a>
  </div>
</section>

<style>
  .everywhere { margin: 34px 0 8px; }
  .doors { display: grid; gap: 10px; margin-top: 14px;
    grid-template-columns: repeat(auto-fit, minmax(215px, 1fr)); max-width: 900px; }
  .door { display: flex; gap: 11px; align-items: center; text-decoration: none;
    background: var(--panel); border: 1px solid var(--border); border-radius: 12px;
    padding: 12px 14px; transition: border-color .15s ease; }
  .door:hover { border-color: var(--accent); }
  .ic { font-size: 21px; line-height: 1; }
  .door strong { display: block; color: var(--text); font-size: 14px; font-weight: 600; }
  .door small { display: block; color: var(--muted); font-size: 12.5px; margin-top: 1px; }
</style>
