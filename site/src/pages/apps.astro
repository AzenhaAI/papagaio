---
import BaseLayout from '../layouts/BaseLayout.astro';
// Downloads go through our own hostname, which proxies the release assets:
// a store-bound product does not put an account name on a download button.
const APP_STORE = 'https://apps.apple.com/app/papagaio-portugal/id6802084974';
// Flip when the Play listing is public: until then the badge shows "coming
// soon" and links nowhere, because a Play URL 404s for an unreleased app and
// a dead badge on a download page reads as a broken product.
const PLAY_LIVE = true;
const PLAY = 'https://play.google.com/store/apps/details?id=ai.azenha.papagaio';
const apple = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.4 12.8c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.6-1.3-.1-2.5.7-3.1.7-.7 0-1.7-.7-2.8-.7-1.4 0-2.7.8-3.4 2.1-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.5 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7s1.7.7 2.8.7c1.2 0 1.9-1 2.6-2.1.8-1.2 1.1-2.3 1.2-2.4 0 0-2.7-1-2.7-3.4ZM14.3 6.6c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.6.7-1 1.6-.9 2.6 1 .1 2-.5 2.5-1.2Z"/></svg>';
const play = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#00d7fe" d="M4.6 2.6a1 1 0 0 0-.5.9v17a1 1 0 0 0 .5.9l9.1-9.4-9.1-9.4Z"/><path fill="#00f076" d="m14.8 10.9 2.9-3-9.9-5.6 7 8.6Z"/><path fill="#ff3a44" d="m14.8 13.1-7 8.6 9.9-5.6-2.9-3Z"/><path fill="#ffd500" d="m18.9 10.9-2.4-1.4-3 3.5 3 3.5 2.4-1.4c.9-.5.9-1.7 0-2.2Z"/></svg>';
const appStoreBadge = `<a class="store" href="${APP_STORE}" target="_blank" rel="noopener">${apple}<span><small>Download on the</small>App Store</span></a>`;
const playBadge = PLAY_LIVE
  ? `<a class="store" href="${PLAY}" target="_blank" rel="noopener">${play}<span><small>Get it on</small>Google Play</span></a>`
  : `<span class="store soon-badge" title="The Google Play listing is in review">${play}<span><small>Coming soon to</small>Google Play</span></span>`;
---
<BaseLayout
  title="Apps — PapaGaio"
  desc="PapaGaio on your phone, your Mac, your PC and in Telegram: European Portuguese dictionary, verb conjugator, translator and AI coach, free on every platform.">
  <h1 data-t>One parrot, every screen</h1>
  <p class="lead" data-t>Free everywhere. One account — your cards follow you.</p>

  <div class="stores" data-unfold set:html={appStoreBadge + playBadge} />

  <!-- One tile per door: an icon, a name, one line. The paragraphs that used
       to sit here explained every platform to everyone; the tile the visitor
       is actually holding is marked by the script below instead, and the
       install advice lives in the fold under the grid. -->
  <div class="tiles" data-unfold>
    <a class="tile" data-os="ios" href={APP_STORE} target="_blank" rel="noopener">
      <span class="ic">📱</span><b data-t>iPhone &amp; iPad</b><small>App Store</small>
    </a>
    <a class="tile" data-os="android" href={PLAY} target="_blank" rel="noopener">
      <span class="ic">🤖</span><b>Android</b><small>Google Play</small>
    </a>
    <a class="tile" data-os="mac" href="/dl/PapaGaio-mac.dmg">
      <span class="ic">💻</span><b>Mac</b><small>22 MB</small>
    </a>
    <a class="tile" data-os="win" href="/dl/PapaGaio-windows.zip">
      <span class="ic">🪟</span><b>Windows</b><small>19 MB</small>
    </a>
    <a class="tile" href="https://t.me/papagaio_ebot">
      <span class="ic">✈️</span><b>Telegram</b><small>@papagaio_ebot</small>
    </a>
    <a class="tile" id="tile-web" href="./translate/">
      <span class="ic">🌐</span><b data-t>Browser</b><small id="tile-web-line" data-t>Nothing to install</small>
    </a>
    <a class="tile" href="/dl/PapaGaio-chrome.zip">
      <span class="ic">🧩</span><b>Chrome</b><small data-t>Extension</small>
    </a>
    <a class="tile" href="/dl/PapaGaio.apk">
      <span class="ic">📦</span><b>APK</b><small data-t>Android without Google Play</small>
    </a>
  </div>

  <details class="tips">
    <summary data-t>Install tips</summary>
    <ul>
      <li data-t>APK: allow “unknown apps” when Android asks. It is a separate install from the Google Play one.</li>
      <li data-t>Windows: unzip and run papagaio_app.exe — SmartScreen wants one click.</li>
      <li data-t>Browser on a phone: Share → Add to Home Screen, and it opens like an app.</li>
      <li data-t>Only the apps work offline — the browser asks the server each time.</li>
    </ul>
  </details>

  <style is:global>
    .lead { color: var(--muted); margin: -4px 0 0; font-size: 15px; }
    /* The stores' own badge shape — black, the store's logo, two lines — is
       what people recognise and trust; a green button saying "App Store" is not. */
    .stores { display: flex; flex-wrap: wrap; gap: 10px; margin: 18px 0 6px; }
    .store {
      display: inline-flex; align-items: center; gap: 10px;
      background: #000; color: #fff; text-decoration: none;
      border: 1px solid #555; border-radius: 12px; padding: 8px 16px 8px 12px;
      font: 600 19px/1.1 -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, sans-serif;
      white-space: nowrap; min-width: 168px;
    }
    .store:hover { border-color: #aaa; text-decoration: none; }
    .store svg { width: 30px; height: 30px; flex: 0 0 auto; }
    .store small { display: block; font-size: 11px; font-weight: 500; letter-spacing: .02em; opacity: .9; }
    .store.soon-badge { opacity: .55; cursor: default; }
    .store.soon-badge:hover { border-color: #555; }
    @media (max-width: 420px) {
      .stores { flex-wrap: nowrap; }
      .store { flex: 1 1 0; min-width: 0; font-size: 16px; padding: 7px 10px; gap: 8px; }
      .store svg { width: 24px; height: 24px; }
      .store small { font-size: 9.5px; }
    }

    .tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 18px 0 14px; }
    @media (min-width: 640px) { .tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    .tile {
      position: relative; display: flex; flex-direction: column; gap: 3px;
      background: var(--panel); border: 1px solid var(--border, transparent);
      border-radius: var(--radius, 14px); padding: 14px 14px 13px;
      color: var(--text); text-decoration: none; min-width: 0;
      transition: border-color .15s ease, transform .15s ease;
    }
    .tile:hover { border-color: var(--accent); text-decoration: none; transform: translateY(-1px); }
    .tile .ic { font-size: 28px; line-height: 1; margin-bottom: 6px; }
    .tile b { font-size: 15.5px; font-weight: 700; }
    .tile small { color: var(--muted); font-size: 12.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tile.mine { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent) inset; }
    .tile.mine::after {
      content: attr(data-mine); position: absolute; top: 10px; right: 10px;
      font-size: 10.5px; font-weight: 700; letter-spacing: .03em;
      background: var(--accent); color: #08210f; border-radius: 999px; padding: 2px 7px;
    }

    .tips { margin: 4px 0 8px; color: var(--muted); font-size: 13.5px; }
    .tips summary { cursor: pointer; font-weight: 600; color: var(--text); }
    .tips ul { margin: 8px 0 0; padding-left: 18px; }
    .tips li { margin: 4px 0; }
  </style>
</BaseLayout>

<script>
  import { t } from '../lib/i18n.js';

  // Mark the tile for the device in hand, so nobody reads the grid to find it.
  // An iPad reports itself as a Mac since iPadOS 13; touch points give it away.
  const ua = navigator.userAgent;
  const os = /Android/.test(ua) ? 'android'
    : (/iPhone|iPod|iPad/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)) ? 'ios'
    : /Mac/.test(ua) ? 'mac'
    : /Win/.test(ua) ? 'win' : '';
  const mine = os && document.querySelector(`.tile[data-os="${os}"]`);
  if (mine) {
    mine.classList.add('mine');
    mine.dataset.mine = t('Yours');
    mine.parentElement.prepend(mine);
  }

  // The browser decides whether installing is possible — it fires this event
  // only when it is, and never on a device that already has the app. The
  // Browser tile then installs instead of opening the translator.
  let deferred = null;
  const web = document.getElementById('tile-web');
  const line = document.getElementById('tile-web-line');
  addEventListener('beforeinstallprompt', (e) => {
    if (/Android/.test(ua)) return; // Android gets Google Play, not the web app
    e.preventDefault();
    deferred = e;
    if (line) line.textContent = t('Install as an app');
  });
  web?.addEventListener('click', async (e) => {
    if (!deferred) return;
    e.preventDefault();
    deferred.prompt();
    await deferred.userChoice;
    deferred = null;
    if (line) line.textContent = t('Nothing to install');
  });
</script>
