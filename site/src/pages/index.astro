---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <script is:inline>
    // The tool people open daily is the translator — land there by default.
    // The marketing landing stays reachable at /?home (linked from the menu).
    if (!location.search.includes('home')) location.replace('/papagaio/translate/');
  </script>
  <section style="background:linear-gradient(135deg, var(--panel) 0%, color-mix(in srgb, var(--accent) 14%, var(--panel)) 100%);
    border:1px solid color-mix(in srgb, var(--accent) 35%, transparent); border-radius:18px;
    padding:28px 26px; margin-bottom:34px;">
    <div class="muted" style="font-size:13px; letter-spacing:.06em; text-transform:uppercase;">
      🤖 AI · live · free forever</div>
    <h1 style="margin-top:8px;">Talk your way around Madeira —<br />with an AI Coach that talks back</h1>
    <p class="muted" style="max-width:620px;">
      A live AI conversation partner in European Portuguese. It plays the barista,
      the landlord, the AIMA official — hears you, answers in a neural pt-PT voice,
      corrects you gently mid-scene and writes up your mistakes at the end.
      It even knows which words you've already learned, and sticks to them.
    </p>
    <div style="display:flex; gap:8px; flex-wrap:wrap; margin:14px 0 18px;">
      <span class="hero-chip">☕ Café</span><span class="hero-chip">🏦 Banco</span>
      <span class="hero-chip">🛂 AIMA</span><span class="hero-chip">🩺 Médico</span>
      <span class="hero-chip">🚕 Táxi</span><span class="hero-chip">🐢→🏃 3 speeds</span>
    </div>
    <div style="display:flex; gap:10px; flex-wrap:wrap;">
      <a class="btn" href="/papagaio/coach/">🎭 Talk to the AI Coach</a>
      <a class="btn" href="https://t.me/papagaio_ebot"
        style="background:var(--panel2); color:var(--text);">🎙 Voice version in Telegram</a>
    </div>
  </section>
  <style is:global>
    .hero-chip { background:var(--panel2); border:1px solid color-mix(in srgb, var(--accent) 30%, transparent);
      border-radius:20px; padding:5px 13px; font-size:13.5px; color:var(--text); }
  </style>

  <div class="tilegrid">
    <a class="tile" href="/papagaio/coach/" style="border-color: color-mix(in srgb, var(--accent) 45%, transparent);">
      <span class="tile-emoji">🎭</span><strong>AI Coach</strong>
      <span class="muted">roleplay the café, the bank, AIMA — voice in, voice out</span>
    </a>
    <a class="tile" href="/papagaio/practice/">
      <span class="tile-emoji">🎴</span><strong>Cards</strong>
      <span class="muted">spaced repetition on a <span data-count="deck">1,400+</span>-card pt-PT deck</span>
    </a>
    <a class="tile" href="/papagaio/read/">
      <span class="tile-emoji">📰</span><strong>Reader</strong>
      <span class="muted">paste any text — see exactly what you don't know yet</span>
    </a>
    <a class="tile" href="/papagaio/dictionary/">
      <span class="tile-emoji">📖</span><strong>Dictionary</strong>
      <span class="muted">articles with examples and ten-tense conjugations</span>
    </a>
    <a class="tile" href="/papagaio/translate/">
      <span class="tile-emoji">🔤</span><strong>Translate</strong>
      <span class="muted">guaranteed pt-PT, Brazilian divergences flagged</span>
    </a>
    <a class="tile" href="/papagaio/phrasebook/">
      <span class="tile-emoji">💬</span><strong>Phrasebook</strong>
      <span class="muted"><span data-count="frases">170+</span> phrases people actually say, with native audio</span>
    </a>
    <a class="tile" href="/papagaio/verbs/">
      <span class="tile-emoji">🔀</span><strong>Verbs</strong>
      <span class="muted">conjugate anything — twelve tenses, pt-PT forms</span>
    </a>
    <a class="tile" href="/papagaio/progress/">
      <span class="tile-emoji">📊</span><strong>Progress</strong>
      <span class="muted">review load ahead and a CIPLE readiness proxy</span>
    </a>
    <a class="tile" href="/papagaio/apps/">
      <span class="tile-emoji">⬇️</span><strong>Apps</strong>
      <span class="muted">Android, iPhone, Mac, Windows — free everywhere</span>
    </a>
    <a class="tile" href="https://t.me/papagaio_ebot">
      <span class="tile-emoji">✈️</span><strong>Telegram bot</strong>
      <span class="muted">a card every 15 minutes, voice dialogs, /translate anything</span>
    </a>
  </div>

  <div class="panel" style="margin-top:26px;">
    <div style="display:flex; align-items:baseline; gap:10px;">
      <h2 style="margin:0;">🇵🇹 or 🇧🇷 — can you tell?</h2>
      <span class="muted" id="quiz-score" style="font-size:14px;"></span>
    </div>
    <p class="muted" style="font-size:14.5px; margin:8px 0 14px;">
      Big translators quietly teach the Brazilian word. Pick the one Portugal actually uses.
    </p>
    <div id="quiz"></div>
  </div>

  <h2>What's new</h2>
  <div class="panel" style="padding:16px 22px;">
    <div class="rel"><span class="rel-date">3 Aug</span> Dictionary articles grew tabs — Examples and
      Conjugations with ten tenses, grouped Past / Present / Future, generated by rule so
      <em>pudemos</em> can never come back as <em>podemos</em>. Plus a “recently opened” strip.</div>
    <div class="rel"><span class="rel-date">3 Aug</span> The AI Coach hears you in the browser:
      tap 🎙, speak, it answers out loud. No Telegram needed.</div>
    <div class="rel"><span class="rel-date">29 Jul</span> Conversation mistakes become cards — the recap
      after /stop ships every correction straight into your review queue. Also /undo and /export.</div>
    <div class="rel"><span class="rel-date">29 Jul</span> Production exercises: fill-the-gap, dictation
      and typed answers, plus 154 grammar drills — contractions, ser/estar, conjugation.</div>
    <div class="rel"><span class="rel-date">28 Jul</span> Reader, this website, and the deck at 519
      Portuguese cards + 251 English, every one with native-quality audio.</div>
    <div class="rel"><span class="rel-date">27 Jul</span> PapaGaio hatches: a card every 15 minutes in
      Telegram, and a voice coach that plays the barista.</div>
  </div>

  <style is:global>
    .tilegrid {
      display:grid; grid-template-columns:repeat(auto-fit, minmax(230px, 1fr));
      gap:12px; margin-bottom:8px;
    }
    .tile {
      display:flex; flex-direction:column; gap:3px;
      background:var(--panel); border:1px solid var(--panel2); border-radius:14px;
      padding:16px 18px; color:var(--text); font-size:15px;
    }
    .tile:hover { border-color:var(--accent); text-decoration:none; }
    .tile .muted { font-size:13.5px; line-height:1.45; }
    .tile-emoji { font-size:24px; }
    .rel { padding:9px 0; border-bottom:1px solid var(--panel2); font-size:14.5px; line-height:1.55; }
    .rel:last-child { border-bottom:0; }
    .rel-date {
      display:inline-block; min-width:56px; color:var(--accent2);
      font-size:13px; font-weight:600;
    }
    .qopt {
      background:var(--panel2); border:1px solid transparent; border-radius:10px;
      padding:10px 16px; font:inherit; font-size:15.5px; color:var(--text);
      cursor:pointer; margin:0 8px 8px 0;
    }
    .qopt:hover { border-color:var(--accent); }
    .qopt.right { background:color-mix(in srgb, var(--accent) 25%, var(--panel2)); }
    .qopt.wrong { background:color-mix(in srgb, var(--red) 25%, var(--panel2)); }
  </style>

  <script>
    // Five rounds of the founding question. All words are real deck entries.
    const QUIZ = [
      { en: 'bus', pt: 'autocarro', br: 'ônibus' },
      { en: 'mobile phone', pt: 'telemóvel', br: 'celular' },
      { en: 'breakfast', pt: 'pequeno-almoço', br: 'café da manhã' },
      { en: 'bathroom', pt: 'casa de banho', br: 'banheiro' },
      { en: 'to catch (a bus)', pt: 'apanhar', br: 'pegar' },
    ];
    let qi = 0, qscore = 0;
    const qbox = document.getElementById('quiz');

    function quizRound() {
      if (qi >= QUIZ.length) {
        qbox.innerHTML = `<p style="font-size:16px;">${qscore}/${QUIZ.length} — ` +
          (qscore === QUIZ.length
            ? 'perfect. The deck will still find something you don\'t know.'
            : 'the gap is exactly what PapaGaio drills.') +
          `</p><a class="btn" href="/papagaio/practice/">Start learning →</a>
           <button class="qopt" style="margin-left:8px;" onclick="location.reload()">Play again</button>`;
        return;
      }
      const q = QUIZ[qi];
      const opts = Math.random() < 0.5 ? [q.pt, q.br] : [q.br, q.pt];
      qbox.innerHTML =
        `<div style="margin-bottom:10px;">${qi + 1}/${QUIZ.length} · “<strong>${q.en}</strong>” in Portugal is…</div>` +
        opts.map((o) => `<button class="qopt" data-o="${o}">${o}</button>`).join('');
      qbox.querySelectorAll('.qopt').forEach((b) => {
        b.onclick = () => {
          const right = b.dataset.o === q.pt;
          if (right) qscore++;
          qbox.querySelectorAll('.qopt').forEach((x) => {
            x.disabled = true;
            if (x.dataset.o === q.pt) x.classList.add('right');
            else if (x === b) x.classList.add('wrong');
          });
          document.getElementById('quiz-score').textContent = `${qscore} right`;
          setTimeout(() => { qi++; quizRound(); }, 900);
        };
      });
    }
    quizRound();
  </script>

  <h2 style="margin-top:0;">Translate into European Portuguese</h2>
  <p class="muted" style="max-width: 640px;">
    The Portuguese actually spoken in Portugal and Madeira. Big translators
    default to the Brazilian variant — PapaGaio always answers in pt-PT and
    marks every word where the two diverge.
    <a href="/papagaio/translate/">Open the translator →</a>
  </p>

  <h2>How it works</h2>
  <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:14px;">
    <div class="panel">
      <div style="font-size:26px;">🎭</div>
      <strong>Talk to the AI coach</strong>
      <p class="muted" style="font-size:14.5px; margin:6px 0 0;">
        /talk starts a voice roleplay — café, bank, doctor. It speaks pt-PT,
        hears your replies and corrects gently. /stop gives an error recap.
      </p>
    </div>
    <div class="panel">
      <div style="font-size:26px;">1️⃣</div>
      <strong>Translate anything</strong>
      <p class="muted" style="font-size:14.5px; margin:6px 0 0;">
        Here or in the Telegram bot. Always European Portuguese, misspellings
        corrected, Brazilian divergences flagged.
      </p>
    </div>
    <div class="panel">
      <div style="font-size:26px;">2️⃣</div>
      <strong>One tap → your deck</strong>
      <p class="muted" style="font-size:14.5px; margin:6px 0 0;">
        Every translation has a “Learn this word” button. The phrase
        gets audio and joins your spaced-repetition queue.
      </p>
    </div>
    <div class="panel">
      <div style="font-size:26px;">3️⃣</div>
      <strong>A card every 15 minutes</strong>
      <p class="muted" style="font-size:14.5px; margin:6px 0 0;">
        During working hours the bot sends one-tap cards: recognition, listening,
        pronunciation. Ignore three — it politely goes quiet until tomorrow.
      </p>
    </div>

  </div>

  <h2>Why this exists</h2>
  <p class="muted" style="max-width: 640px;">
    Three years of language schools and every big translator quietly teaching the
    wrong dialect. PapaGaio is a translator, a frequency deck with spaced
    repetition, a pronunciation checker and an AI voice coach — in Telegram,
    free, with no premium tier. <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/about/`}>More →</a>
  </p>

<script>
  // The headline numbers come from the data, not from prose that goes stale.
  fetch('https://papagaio.azenha.ai/api/counts').then((r) => r.json()).then((c) => {
    const fmt = (n) => n.toLocaleString('en-GB');
    const set = (k, v) => document.querySelectorAll(`[data-count="${k}"]`)
      .forEach((el) => { el.textContent = fmt(v); });
    set('deck', c.pt_cards + c.pt_drills);
    set('frases', c.frases);
    set('lexicon', c.lexicon);
    set('en', c.en_cards);
  }).catch(() => {});
</script>
</BaseLayout>
