---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Settings — PapaGaio" desc="PapaGaio settings on the web: Russian in the translator and dictionary, theme, connecting your progress from the app or the Telegram bot, and deleting your data.">
  <h1 data-t>Settings</h1>

  <style is:global>
    .set { background: var(--panel); border-radius: var(--radius); padding: 16px 18px; margin: 0 0 12px; }
    .set h2 { font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0 0 10px; }
    .set .row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 0; }
    .set .row + .row { border-top: 1px solid var(--panel2); }
    .set .row p { margin: 2px 0 0; color: var(--muted); font-size: 13.5px; }
    .seg { display: inline-flex; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; flex: 0 0 auto; }
    .seg button { background: none; border: 0; color: var(--muted); font: inherit; font-size: 14px; padding: 8px 12px; cursor: pointer; min-height: 40px; }
    .seg button.on { background: var(--panel2); color: var(--text); font-weight: 600; }
    .switch { position: relative; width: 50px; height: 30px; flex: 0 0 auto; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .switch span { position: absolute; inset: 0; top: 0; left: 0; right: 0; bottom: 0; background: var(--panel2); border: 1px solid var(--border); border-radius: 30px; cursor: pointer; transition: .2s; }
    .switch span::before { content: ''; position: absolute; width: 22px; height: 22px; left: 3px; top: 3px; background: var(--muted); border-radius: 50%; transition: .2s; }
    .switch input:checked + span { background: var(--accent); border-color: var(--accent); }
    .switch input:checked + span::before { transform: translateX(20px); background: #08130c; }
    .set input[type=text] { flex: 1; min-width: 0; background: var(--panel2); color: var(--text); border: 1px solid var(--border); border-radius: 10px; padding: 9px 12px; font: inherit; }
    .set .danger { background: none; border: 1px solid var(--red); color: var(--red); border-radius: 10px; padding: 8px 14px; font: inherit; cursor: pointer; min-height: 40px; }
    .set.links a { display: block; padding: 9px 0; }
  </style>

  <section class="set" data-unfold>
    <h2 data-t>Languages</h2>
    <div class="row">
      <div>
        <strong data-t>Russian meanings</strong>
        <p data-t>Shows Russian meanings in the dictionary even when the interface is in English or Portuguese.</p>
      </div>
      <label class="switch" aria-label="Russian meanings in the dictionary" data-ta>
        <input type="checkbox" id="ru" /><span></span>
      </label>
    </div>
    <div class="row">
      <div>
        <strong data-t>Interface</strong>
        <p data-t>Switch EN · PT · RU at the top of any page. The apps speak the same three languages.</p>
      </div>
    </div>
  </section>

  <section class="set">
    <h2 data-t>Appearance</h2>
    <div class="row">
      <strong data-t>Theme</strong>
      <div class="seg" role="group" aria-label="Theme" data-ta>
        <button data-theme-opt="system" data-t>System</button>
        <button data-theme-opt="dark" data-t>Dark</button>
        <button data-theme-opt="light" data-t>Light</button>
      </div>
    </div>
  </section>

  <section class="set">
    <h2 data-t>Your progress</h2>
    <div class="row" id="paired" style="display:none;">
      <div>
        <strong data-t>Connected</strong>
        <p id="paired-id"></p>
      </div>
      <button class="danger" id="unpair" style="border-color:var(--border); color:var(--text);" data-t>Disconnect</button>
    </div>
    <div class="row" id="pair" style="display:none; flex-wrap:wrap;">
      <div style="flex:1 1 100%;">
        <strong data-t>Connect your deck</strong>
        <p>Send /link to the <a href="https://t.me/papagaio_ebot">Telegram bot</a> (or open Settings → Pair in the app) and paste the code here. Cards, coach and progress then follow you between devices.</p>
      </div>
      <input type="text" id="tok" aria-label="Link code from the bot" placeholder="paste the /link code" data-tp autocomplete="off" />
      <button class="btn" id="connect" data-t>Connect</button>
      <p id="pair-msg" style="flex:1 1 100%; margin:4px 0 0; color:var(--muted); font-size:13.5px;"></p>
    </div>
  </section>

  <section class="set">
    <h2 data-t>Your data</h2>
    <div class="row">
      <div>
        <strong data-t>Delete my account</strong>
        <p data-t>Erases your schedule, history, your own cards and every paired device. Immediate, cannot be undone. In the bot: /delete.</p>
      </div>
      <button class="danger" id="del" data-t>Delete</button>
    </div>
    <p class="muted" id="del-msg" style="font-size:13.5px; margin:4px 0 0;"></p>
  </section>

  <section class="set links">
    <h2 data-t>More</h2>
    <a href={`${base}/verbs/`}>🔀 <span data-t>Verbs</span></a>
    <a href={`${base}/apps/`}>📱 <span data-t>Apps for iPhone, Android, Mac and Windows</span></a>
    <a href={`${base}/privacy/`}>🔒 <span data-t>Privacy</span></a>
    <a href={`${base}/support/`}>💬 <span data-t>Support</span></a>
    <a href={`${base}/about/`}>ℹ️ <span data-t>About</span></a>
  </section>

  <script is:inline>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      // The layout's module script sets pgT after this inline one has run.
      var T = function (x) { return window.pgT ? window.pgT(x) : x; };
      // Russian: one switch the translator and the dictionary both read.
      var ru = $('ru');
      ru.checked = localStorage.getItem('pg_ru') === '1';
      ru.onchange = function () { localStorage.setItem('pg_ru', ru.checked ? '1' : '0'); };

      // Theme: "system" removes the override and follows the device.
      var segs = document.querySelectorAll('.seg button');
      function paintTheme() {
        var t = localStorage.getItem('pg_theme') || 'system';
        segs.forEach(function (b) { b.classList.toggle('on', b.getAttribute('data-theme-opt') === t); });
      }
      segs.forEach(function (b) {
        b.onclick = function () {
          var t = b.getAttribute('data-theme-opt');
          if (t === 'system') {
            localStorage.removeItem('pg_theme');
            var light = window.matchMedia && matchMedia('(prefers-color-scheme: light)').matches;
            if (light) document.documentElement.dataset.theme = 'light';
            else delete document.documentElement.dataset.theme;
          } else {
            localStorage.setItem('pg_theme', t);
            document.documentElement.dataset.theme = t;
          }
          paintTheme();
        };
      });
      paintTheme();

      // Progress: the same token the cards, coach and progress pages use.
      var KEY = 'pg_token';
      function paintPair() {
        var t = localStorage.getItem(KEY);
        $('paired').style.display = t ? 'flex' : 'none';
        $('pair').style.display = t ? 'none' : 'flex';
        if (t) $('paired-id').textContent = T('Device') + ' ' + t.slice(0, 8) + '…';
      }
      $('connect').onclick = function () {
        window.pgUseCode($('tok').value).then(function (res) {
          if (res.ok) { $('tok').value = ''; paintPair(); }
          $('pair-msg').textContent = res.ok ? '' : res.msg;
        });
      };
      $('unpair').onclick = function () {
        if (!confirm(T('Disconnect this browser? Your progress stays on the server and comes back with the code.'))) return;
        localStorage.removeItem(KEY);
        paintPair();
      };
      paintPair();
      document.addEventListener('DOMContentLoaded', paintPair);

      $('del').onclick = async function () {
        var t = localStorage.getItem(KEY);
        if (!t) { $('del-msg').textContent = T('Nothing to delete: this browser has no account yet.'); return; }
        if (!confirm(T('Delete your PapaGaio account and all its progress? This cannot be undone.'))) return;
        try {
          var r = await fetch('/api/account', { method: 'DELETE', headers: { 'x-device-token': t } });
          if (!r.ok) throw new Error(r.status);
          localStorage.removeItem(KEY);
          paintPair();
          $('del-msg').textContent = T('Deleted. Everything tied to this account is gone.');
        } catch (e) {
          $('del-msg').textContent = T('The server is not answering right now — nothing was deleted. Try again later.');
        }
      };
    })();
  </script>
</BaseLayout>
