---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="AI Coach — PapaGaio" desc="Roleplay real situations in European Portuguese — café, bank, AIMA — with a coach that corrects gently and recaps your mistakes.">
  <h1>AI Coach</h1>
  <p class="muted" style="max-width:640px;">
    A live AI conversation partner. Pick a scene and play it out — it stays in
    character, speaks pt-PT, adapts to the words you have already learned,
    corrects you gently as you go, and writes a recap of your mistakes at the
    end. In the <a href="https://t.me/papagaio_ebot">Telegram bot</a> the same
    coach listens to your voice and answers with one.
  </p>
  <p class="muted" style="font-size:13px; margin-top:-6px;">
    🤖 Powered by an LLM on Groq + neural pt-PT voices. Every reply is generated
    live — no scripts beyond the opening line.
  </p>

  <div id="gate" class="panel" style="margin-top:20px;">
    <p style="margin:0;" id="gate-msg">Getting you a scene…</p>
  </div>

  <details id="link" style="margin-top:20px;">
    <summary class="muted" style="cursor:pointer;">Already learning in the Telegram bot?</summary>
    <p class="muted" style="font-size:14.5px; max-width:640px;">
      Send <code>/link</code> to the <a href="https://t.me/papagaio_ebot">bot</a> and paste the code
      to carry your deck over — the coach will then prefer words you have already learned.
    </p>
    <div style="display:flex; gap:8px; flex-wrap:wrap;">
      <input id="tok" type="text" placeholder="paste the /link code from the bot"
        style="flex:1; min-width:240px; background:var(--panel2); color:var(--text);
               border:1px solid #2a4433; border-radius:10px; padding:8px 14px; font:inherit;" />
      <button class="btn" id="tok-save">Connect</button>
    </div>
  </details>

  <div id="pick" style="display:none;">
    <h2 style="margin-top:22px;">Pick a scene</h2>
    <div style="display:flex; gap:10px; margin-bottom:12px;">
      <button class="cbtn active" data-c="pt" id="c-pt">🇵🇹 Português</button>
      <button class="cbtn" data-c="en" id="c-en">🇬🇧 English</button>
    </div>
    <div id="scenes" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:10px;"></div>
    <div id="levels" style="display:none; margin-top:14px;">
      <div class="muted" style="font-size:14px; margin-bottom:8px;">How should the coach speak?</div>
      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <button class="lbtn" data-l="slow">🐢 Slow &amp; simple</button>
        <button class="lbtn" data-l="normal">🚶 Normal</button>
        <button class="lbtn" data-l="street">🏃 Street</button>
      </div>
    </div>
  </div>

  <div id="chat" style="display:none;">
    <div style="display:flex; align-items:center; gap:10px; margin:20px 0 10px;">
      <strong id="scene-name"></strong>
      <button id="finish" style="margin-left:auto; background:var(--panel2); color:var(--text);
        border:1px solid var(--red); border-radius:10px; padding:6px 16px; font:inherit; cursor:pointer;">
        🏁 Finish &amp; recap</button>
    </div>
    <div class="panel" id="log" style="max-height:55vh; overflow-y:auto;"></div>
    <div style="display:flex; gap:8px; margin-top:10px;">
      <input id="say" placeholder="type in Portuguese — or tap 🎙 and speak" autocomplete="off"
        style="flex:1; background:var(--panel2); color:var(--text); border:1px solid #2a4433;
               border-radius:10px; padding:12px 14px; font:inherit; font-size:16px;" />
      <button id="mic" title="Speak your reply"
        style="background:var(--panel2); border:1px solid #2a4433; border-radius:10px;
               font-size:20px; padding:0 16px; cursor:pointer;">🎙</button>
      <button class="btn" id="send">Send</button>
    </div>
    <div class="muted" id="micstate" style="font-size:13px; margin-top:6px;">
      🎙 speak instead of typing — the coach will answer out loud
    </div>
  </div>

  <div id="recap" class="panel" style="display:none; margin-top:16px;"></div>

  <style is:global>
    .cbtn { background:var(--panel2); color:var(--text); border:1px solid #2a4433;
      border-radius:10px; padding:8px 16px; font:inherit; cursor:pointer; }
    .cbtn.active { background:var(--accent); color:#08130c; font-weight:600; border-color:var(--accent); }
    .scene { background:var(--panel); border:1px solid var(--panel2); border-radius:12px;
      padding:14px; font:inherit; color:var(--text); cursor:pointer; text-align:left; font-size:15px; }
    .scene:hover { border-color:var(--accent); }
    .lbtn { background:var(--panel2); color:var(--text); border:1px solid #2a4433;
      border-radius:10px; padding:8px 16px; font:inherit; cursor:pointer; }
    .lbtn:hover { border-color:var(--accent); }
    .msg { margin:10px 0; max-width:85%; }
    .msg .b { padding:10px 14px; border-radius:12px; display:inline-block; }
    .coach .b { background:var(--panel2); }
    .me { text-align:right; margin-left:auto; }
    .me .b { background:color-mix(in srgb, var(--accent) 22%, var(--panel2)); }
    .note { font-size:13.5px; color:var(--accent2); margin-top:4px; }
    .speak { background:none; border:0; cursor:pointer; font-size:15px; padding:0 4px; }
  </style>

  <script>
    const API = '';   // same origin: /api/* is routed to the worker
    const $ = (id) => document.getElementById(id);
    const TOKKEY = 'pg_token';
    const esc = (s) => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    let course = 'pt';
    let scene = null;
    let level = 'normal';

    $('tok-save').onclick = () => {
      const v = $('tok').value.trim();
      if (v) { localStorage.setItem(TOKKEY, v); boot(); }
    };
    const headers = () => ({ 'content-type': 'application/json', 'x-device-token': localStorage.getItem(TOKKEY) });

    document.querySelectorAll('.cbtn').forEach((b) => b.onclick = () => {
      course = b.dataset.c;
      document.querySelectorAll('.cbtn').forEach((x) => x.classList.toggle('active', x === b));
      scenes();
    });

    // Nobody should have to visit Telegram before they can try the coach. With no
    // token we mint an anonymous device — the endpoint exists for exactly this —
    // so the first visit goes straight into a scene.
    async function boot() {
      if (!localStorage.getItem(TOKKEY)) {
        $('gate-msg').textContent = 'Getting you a scene…';
        try {
          const r = await fetch(`${API}/api/device`, {
            method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ courses: 'pt,en' }),
          });
          const d = await r.json();
          if (!d.token) throw new Error(d.error ?? 'could not start a session');
          localStorage.setItem(TOKKEY, d.token);
        } catch (e) {
          $('gate-msg').textContent = 'Could not start a session: ' + e.message;
          return;
        }
      }
      const r = await fetch(`${API}/api/progress`, { headers: headers() });
      if (!r.ok) {
        // A stale or mistyped token: drop it and let the next load mint a fresh one.
        localStorage.removeItem(TOKKEY);
        $('gate-msg').textContent = 'That code did not work — reload to start a fresh session.';
        return;
      }
      $('gate').style.display = 'none';
      $('pick').style.display = 'block';
      scenes();
    }

    async function scenes() {
      const r = await fetch(`${API}/api/coach/scenarios?course=${course}`);
      const d = await r.json();
      $('scenes').innerHTML = d.scenarios.map((s) =>
        `<button class="scene" data-k="${s.key}">${esc(s.label)}</button>`).join('');
      $('levels').style.display = 'none';
      document.querySelectorAll('.scene').forEach((b) => b.onclick = () => {
        scene = b.dataset.k;
        document.querySelectorAll('.scene').forEach((x) => x.style.borderColor = x === b ? 'var(--accent)' : '');
        $('levels').style.display = 'block';
      });
    }

    document.querySelectorAll('.lbtn').forEach((b) => b.onclick = () => start(b.dataset.l));

    async function start(lvl) {
      level = lvl;
      const r = await fetch(`${API}/api/coach`, {
        method: 'POST', headers: headers(),
        body: JSON.stringify({ start: true, course, scenario: scene, level }),
      });
      const d = await r.json();
      if (d.error) { alert(d.error); return; }
      $('pick').style.display = 'none';
      $('recap').style.display = 'none';
      $('chat').style.display = 'block';
      $('log').innerHTML = '';
      $('scene-name').textContent = d.label ?? scene;
      bubble('coach', d.reply, d.note);
      $('say').focus();
    }

    function bubble(who, text, note) {
      const div = document.createElement('div');
      div.className = `msg ${who === 'me' ? 'me' : 'coach'}`;
      div.innerHTML = `<span class="b">${esc(text)}</span>` +
        (who === 'coach' ? `<button class="speak" title="listen">🔊</button>` : '') +
        (note ? `<div class="note">✏️ ${esc(note)}</div>` : '');
      $('log').appendChild(div);
      $('log').scrollTop = $('log').scrollHeight;
      const sp = div.querySelector('.speak');
      if (sp) sp.onclick = async () => {
        const r = await fetch(`${API}/api/tts`, {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ text, course }),
        });
        if (r.ok) pgPlayUrl(URL.createObjectURL(await r.blob()));
      };
    }

    // ---- microphone ----
    let rec = null, chunks = [], recording = false;
    const HINT = '🎙 speak instead of typing — the coach will answer out loud';

    async function micToggle() {
      if (recording) {
        // stop() throws InvalidStateError when the system already killed the
        // recording (a call, tab switch, screen sleep). Without the catch the
        // red state stuck forever and every next tap died on the same line.
        try { rec.stop(); } catch {
          recording = false;
          $('mic').style.background = 'var(--panel2)';
          $('micstate').textContent = HINT;
        }
        return;
      }
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        const mime = ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4']
          .find((m) => MediaRecorder.isTypeSupported(m)) || '';
        rec = new MediaRecorder(stream, mime ? { mimeType: mime } : {});
        chunks = [];
        rec.ondataavailable = (e) => chunks.push(e.data);
        rec.onstop = async () => {
          stream.getTracks().forEach((t) => t.stop());
          recording = false;
          $('mic').style.background = 'var(--panel2)';
          $('micstate').textContent = '🤖 a ouvir…';
          const blob = new Blob(chunks, { type: rec.mimeType || 'audio/webm' });
          const ext = (rec.mimeType || 'webm').includes('mp4') ? 'm4a' : 'webm';
          const fd = new FormData();
          fd.append('audio', blob, `say.${ext}`);
          fd.append('language', course);
          // Network can vanish mid-hike; without a timeout this stuck on
          // "a ouvir…" forever and read as a hang.
          try {
            const r = await fetch(`${API}/api/transcribe`, {
              method: 'POST',
              headers: { 'x-device-token': localStorage.getItem(TOKKEY) },
              body: fd,
              signal: AbortSignal.timeout(30000),
            });
            const d = await r.json();
            $('micstate').textContent = HINT;
            if (d.text) { $('say').value = d.text; send(true); }
            else $('micstate').textContent = '🎙 ' + (d.error ?? 'did not catch that — try again');
          } catch {
            $('micstate').textContent = '🎙 lost the connection — check the network and try again';
          }
        };
        rec.start();
        recording = true;
        $('mic').style.background = 'color-mix(in srgb, var(--red) 40%, var(--panel2))';
        $('micstate').textContent = '🔴 recording — tap 🎙 again to stop';
      } catch {
        $('micstate').textContent = 'microphone blocked — allow it in the browser and retry';
      }
    }
    $('mic').onclick = micToggle;

    async function speak(text) {
      const r = await fetch(`${API}/api/tts`, {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ text, course }),
      });
      if (r.ok) pgPlayUrl(URL.createObjectURL(await r.blob()));
    }

    async function send(voiced = false) {
      const text = $('say').value.trim();
      if (!text) return;
      $('say').value = '';
      bubble('me', text);
      const think = document.createElement('div');
      think.className = 'msg coach';
      think.innerHTML = '<span class="b muted">🤖 a pensar…</span>';
      $('log').appendChild(think);
      $('log').scrollTop = $('log').scrollHeight;
      const r = await fetch(`${API}/api/coach`, {
        method: 'POST', headers: headers(),
        body: JSON.stringify({ message: text, course, scenario: scene, level }),
      });
      const d = await r.json();
      think.remove();
      if (d.reply) {
        bubble('coach', d.reply, d.note);
        // A spoken turn earns a spoken answer — the full voice loop, in a browser.
        if (voiced) speak(d.reply);
      }
    }
    $('send').onclick = () => send(false);
    $('say').addEventListener('keydown', (e) => { if (e.key === 'Enter') send(); });

    $('finish').onclick = async () => {
      const r = await fetch(`${API}/api/coach`, {
        method: 'POST', headers: headers(), body: JSON.stringify({ stop: true }),
      });
      const d = await r.json();
      $('chat').style.display = 'none';
      $('pick').style.display = 'block';
      $('recap').style.display = 'block';
      $('recap').innerHTML = `<strong>🏁 Recap</strong><div style="margin-top:8px; white-space:pre-wrap;">${esc(d.recap ?? d.reply ?? 'Session closed.')}</div>`;
      scenes();
    };

    boot();
  </script>
</BaseLayout>
