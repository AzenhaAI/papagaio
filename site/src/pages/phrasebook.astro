---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppHandoff from '../components/AppHandoff.astro';
import data from '../data/words.json';

// The phrases and the song shelf are written into the page at build time from
// the deck (src/data/words.json), each linking to its own word page. They used
// to arrive by script from /api/deck, fetched twice, so search engines saw an
// empty list and none of the 200 links.
const AUDIO = 'https://audio.azenha.ai/';
const deck = data.pages.filter((p) => !p.lex).sort((a, b) => (a.rank ?? 1e9) - (b.rank ?? 1e9));
const phrases = deck.filter((p) => (p.tags ?? []).includes('frase'));
const fado = deck.filter((p) => (p.tags ?? []).includes('fado'));
const ru1 = (p) => String(p.meanings?.[0]?.ru ?? p.trans_ru ?? '').split(/[;/]| \(/)[0].trim();
---
<BaseLayout
  title="Phrasebook — PapaGaio"
  desc="The European Portuguese phrases people actually say — se calhar, pois é, está bem — with native audio and the literal story behind each one.">
  <h1 data-th="phrasebook.title">Phrasebook</h1>
  <p class="muted" data-th="phrasebook.lead">
    The phrases that carry real conversations in Portugal — the ones textbooks
    save for chapter twelve and Lisbon uses before breakfast. Native audio on
    every line. Tap a phrase for its full article.
  </p>

  <div class="panel" style="margin-top:18px; padding:16px 18px;">
    <strong style="font-size:15px;" data-th="phrasebook.search-title">🔎 Search real sentences</strong>
    <p class="muted" style="font-size:13px; margin:4px 0 10px;" data-th="phrasebook.search-note">
      181,000 sentence pairs from <a href="https://tatoeba.org">Tatoeba</a> (CC-BY).
      Type any Portuguese word — see how people actually use it.</p>
    <div style="display:flex; gap:8px;">
      <input id="sq" aria-label="Search sentences" type="search" placeholder="se calhar, saudade, dá para…"
        style="flex:1; min-width:0; background:var(--panel2); color:var(--text); border:1px solid #2a4433;
               border-radius:10px; padding:8px 14px; font:inherit;" />
      <select id="spair" aria-label="Language pair" style="background:var(--panel2); color:var(--text); border:1px solid #2a4433;
               border-radius:10px; padding:8px 10px; font:inherit;">
        <option value="pt-en">PT → EN</option>
        <option value="pt-ru">PT → RU</option>
        <option value="en-ru">EN → RU</option>
      </select>
    </div>
    <div id="sres" style="margin-top:10px;"></div>
  </div>

  <div id="list" style="margin-top:18px;">
    {phrases.map((c) => (
      <div class="panel phr" id={c.slug}>
        <div class="phr-head">
          <a class="phr-term" href={`/papagaio/palavra/${c.slug}/`}>{c.term}</a>
          <span class="muted">— <span class="tr-en">{c.trans}</span>{ru1(c) && <span class="tr-ru">{ru1(c)}</span>}</span>
          {c.audio && <button type="button" class="phr-say" data-audio={AUDIO + c.audio} data-ta aria-label="Listen" title="Listen">🔊</button>}
        </div>
        {c.note && <div class="muted phr-note" lang="en">{c.note}</div>}
        {c.ex_t && <div class="muted phr-ex"><span lang="pt-PT">{c.ex_t}</span>{c.ex_trans && <> — <span lang="en">{c.ex_trans}</span></>}</div>}
      </div>
    ))}
    {fado.length > 0 && <>
      <h2 style="margin-top:30px;" data-th="phrasebook.fado-title">🎶 Fado &amp; song words</h2>
      <p class="muted" style="font-size:13.5px;" data-th="phrasebook.fado-lead">The vocabulary fado and the
        bailinho are made of — saudade, o cais, o luar. Take them to the
        <a href="/papagaio/coach/">coach</a>: there's a casa-de-fados scene to try them in.</p>
      {fado.map((c) => (
        <div class="panel phr" id={c.slug}>
          <div class="phr-head">
            <a class="phr-term" href={`/papagaio/palavra/${c.slug}/`}>{c.term}</a>
            <span class="muted">— <span class="tr-en">{c.trans}</span>{ru1(c) && <span class="tr-ru">{ru1(c)}</span>}</span>
            {c.audio && <button type="button" class="phr-say" data-audio={AUDIO + c.audio} data-ta aria-label="Listen" title="Listen">🔊</button>}
          </div>
          {c.ex_t && <div class="muted phr-ex"><span lang="pt-PT">{c.ex_t}</span>{c.ex_trans && <> — <span lang="en">{c.ex_trans}</span></>}</div>}
        </div>
      ))}
    </>}
  </div>

  <style>
    .phr { margin-bottom: 10px; padding: 14px 18px; scroll-margin-top: 80px; }
    .phr:target { border-color: var(--accent); }
    .phr-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .phr-term { font-size: 17.5px; font-weight: 700; color: var(--text); text-decoration: none; }
    .phr-term:hover { text-decoration: underline; }
    .phr-say { background: none; border: 0; cursor: pointer; font-size: 16px; }
    .phr-note, .phr-ex { font-size: 13.5px; margin-top: 2px; }
    .phr-ex { font-style: italic; }
    /* The meaning in the reader's language: Russian on the Russian pages. */
    .tr-ru { display: none; }
    :global(html[data-ui="ru"]) .tr-ru { display: inline; }
    :global(html[data-ui="ru"]) .tr-en { display: none; }
  </style>

  <p class="muted" style="margin-top:22px; font-size:13.5px;" data-th="phrasebook.footer">
    These are cards from <a href="/papagaio/dictionary/">the deck</a> — the bot drills
    them with spaced repetition, and the
    <a href="/papagaio/coach/">AI coach</a> makes you use them in scenes.
  </p>

  <script>
    const AUDIO = 'https://audio.azenha.ai/';
    const EXAPI = '/api/examples';

    // Sentence search: debounced, race-guarded, TTS on every Portuguese line.
    let sseq = 0, stimer;
    const sres = document.getElementById('sres');
    const esc2 = (s) => String(s ?? '').replace(/[&<>"]/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    async function ssearch() {
      const q = document.getElementById('sq').value.trim();
      const pair = document.getElementById('spair').value;
      if (q.length < 2) { sres.innerHTML = ''; return; }
      const mine = ++sseq;
      let d;
      try {
        d = await (await fetch(`${EXAPI}?q=${encodeURIComponent(q)}&pair=${pair}&limit=15`)).json();
      } catch { d = { error: 'network' }; }
      if (mine !== sseq) return;
      if (d?.error) {
        sres.innerHTML = `<p class="muted" style="font-size:13.5px;">${esc2(d.message || 'The sentence search is not answering right now — try again in a minute.')}</p>`;
        return;
      }
      sres.innerHTML = (d?.examples ?? []).map((e) => `
        <div style="padding:8px 0; border-bottom:1px solid var(--panel2); font-size:14.5px;">
          ${esc2(e.src)}
          ${pair.startsWith('pt') ? `<button onclick="playTts(this, ${JSON.stringify(e.src).replace(/"/g, '&quot;')})"
            style="background:none; border:0; cursor:pointer; font-size:13px;">🔊</button>` : ''}
          <div class="muted" style="font-size:13.5px;">${esc2(e.dst)}</div>
        </div>`).join('') || '<p class="muted" style="font-size:13.5px;">Nothing found in this pair.</p>';
    }
    window.playTts = async (btn, text) => {
      const r = await fetch('/api/tts', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ text, course: 'pt' }),
      });
      if (r.ok) pgPlayUrl(URL.createObjectURL(await r.blob()));
    };
    document.getElementById('sq').addEventListener('input', () => {
      clearTimeout(stimer); stimer = setTimeout(ssearch, 350);
    });
    document.getElementById('spair').addEventListener('change', ssearch);
    // The 🔊 on each phrase plays its recorded audio.
    document.getElementById('list')?.addEventListener('click', (e) => {
      const b = (e.target as Element).closest?.('.phr-say') as HTMLElement | null;
      if (b?.dataset.audio) (window as any).pgPlayUrl(b.dataset.audio, b);
    });
  </script>
  <AppHandoff place="phrasebook" />
</BaseLayout>
