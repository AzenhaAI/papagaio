---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Portuguese phrasebook — PapaGaio"
  desc="The European Portuguese phrases people actually say — se calhar, pois é, está bem — with native audio and the literal story behind each one.">
  <h1>Phrasebook</h1>
  <p class="muted">
    The phrases that carry real conversations in Portugal — the ones textbooks
    save for chapter twelve and Lisbon uses before breakfast. Native audio on
    every line. Tap a phrase for its full article.
  </p>

  <div class="panel" style="margin-top:18px; padding:16px 18px;">
    <strong style="font-size:15px;">🔎 Search real sentences</strong>
    <p class="muted" style="font-size:13px; margin:4px 0 10px;">
      181,000 sentence pairs from <a href="https://tatoeba.org">Tatoeba</a> (CC-BY).
      Type any Portuguese word — see how people actually use it.</p>
    <div style="display:flex; gap:8px;">
      <input id="sq" type="search" placeholder="se calhar, saudade, dá para…"
        style="flex:1; background:var(--panel2); color:var(--text); border:1px solid #2a4433;
               border-radius:10px; padding:8px 14px; font:inherit;" />
      <select id="spair" style="background:var(--panel2); color:var(--text); border:1px solid #2a4433;
               border-radius:10px; padding:8px 10px; font:inherit;">
        <option value="pt-en">PT → EN</option>
        <option value="pt-ru">PT → RU</option>
        <option value="en-ru">EN → RU</option>
      </select>
    </div>
    <div id="sres" style="margin-top:10px;"></div>
  </div>

  <div id="list" style="margin-top:18px;"><p class="muted">loading…</p></div>

  <p class="muted" style="margin-top:22px; font-size:13.5px;">
    These are cards from <a href="./dictionary/">the deck</a> — the bot drills
    them with spaced repetition, and the
    <a href="./coach/">AI coach</a> makes you use them in scenes.
  </p>

  <script>
    const AUDIO = 'https://shpara.com/papagaio/audio/';
    const EXAPI = 'https://papagaio.kirshp.workers.dev/api/examples';

    // Sentence search: debounced, race-guarded, TTS on every Portuguese line.
    let sseq = 0, stimer;
    const sres = document.getElementById('sres');
    const esc2 = (s) => String(s ?? '').replace(/[&<>"]/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    async function ssearch() {
      const q = document.getElementById('sq').value.trim();
      const pair = document.getElementById('spair').value;
      if (q.length < 2) { sres.innerHTML = ''; return; }
      const mine = ++sseq;
      let d;
      try {
        d = await (await fetch(`${EXAPI}?q=${encodeURIComponent(q)}&pair=${pair}&limit=15`)).json();
      } catch { d = null; }
      if (mine !== sseq) return;
      sres.innerHTML = (d?.examples ?? []).map((e) => `
        <div style="padding:8px 0; border-bottom:1px solid var(--panel2); font-size:14.5px;">
          ${esc2(e.src)}
          ${pair.startsWith('pt') ? `<button onclick="playTts(this, ${JSON.stringify(e.src).replace(/"/g, '&quot;')})"
            style="background:none; border:0; cursor:pointer; font-size:13px;">🔊</button>` : ''}
          <div class="muted" style="font-size:13.5px;">${esc2(e.dst)}</div>
        </div>`).join('') || '<p class="muted" style="font-size:13.5px;">Nothing found in this pair.</p>';
    }
    window.playTts = async (btn, text) => {
      const r = await fetch('https://papagaio.kirshp.workers.dev/api/tts', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ text, course: 'pt' }),
      });
      if (r.ok) new Audio(URL.createObjectURL(await r.blob())).play();
    };
    document.getElementById('sq').addEventListener('input', () => {
      clearTimeout(stimer); stimer = setTimeout(ssearch, 350);
    });
    document.getElementById('spair').addEventListener('change', ssearch);
    const API = 'https://papagaio.kirshp.workers.dev/api/deck?course=pt&limit=2000';
    const list = document.getElementById('list');
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    (async () => {
      let cards = [];
      try {
        cards = (await (await fetch(API)).json()).cards
          .filter((c) => (c.tags ?? '').includes('"frase"'));
      } catch {
        list.innerHTML = '<p class="muted">Could not load the phrasebook — try again in a minute.</p>';
        return;
      }
      const fado = (await (await fetch(API)).json()).cards
        .filter((c) => (c.tags ?? '').includes('"fado"'));
      list.innerHTML = cards.map((c) => `
        <div class="panel" style="margin-bottom:10px; padding:14px 18px;">
          <div style="display:flex; align-items:baseline; gap:12px; flex-wrap:wrap;">
            <strong style="font-size:17.5px;">${esc(c.term)}</strong>
            <span class="muted">— ${esc(c.trans)}</span>
            ${c.audio ? `<button onclick="new Audio('${AUDIO}${esc(c.audio)}').play()"
              style="background:none; border:0; cursor:pointer; font-size:16px;">🔊</button>` : ''}
          </div>
          ${c.note ? `<div class="muted" style="font-size:13.5px; margin-top:2px;">${esc(c.note)}</div>` : ''}
          ${c.ex_t ? `<div class="muted" style="font-size:13.5px; font-style:italic; margin-top:2px;">
            ${esc(c.ex_t)}${c.ex_trans ? ` — ${esc(c.ex_trans)}` : ''}</div>` : ''}
        </div>`).join('') || '<p class="muted">Nothing here yet.</p>';

      // The song shelf: fado and Madeiran folk vocabulary. Words, never lyrics
      // — songwriters own their lines; the images are everybody's.
      if (fado.length) {
        list.innerHTML += `<h2 style="margin-top:30px;">🎶 Fado & song words</h2>
          <p class="muted" style="font-size:13.5px;">The vocabulary fado and the
          bailinho are made of — saudade, o cais, o luar. Take them to the
          <a href="../coach/">coach</a>: there's a casa-de-fados scene to try them in.</p>` +
          fado.map((c) => `
          <div class="panel" style="margin-bottom:10px; padding:14px 18px;">
            <div style="display:flex; align-items:baseline; gap:12px; flex-wrap:wrap;">
              <strong style="font-size:17.5px;">${esc(c.term)}</strong>
              <span class="muted">— ${esc(c.trans)}</span>
              ${c.audio ? `<button onclick="new Audio('${AUDIO}${esc(c.audio)}').play()"
                style="background:none; border:0; cursor:pointer; font-size:16px;">🔊</button>` : ''}
            </div>
            ${c.note ? `<div class="muted" style="font-size:13.5px; margin-top:2px;">${esc(c.note)}</div>` : ''}
            ${c.ex_t ? `<div class="muted" style="font-size:13.5px; font-style:italic; margin-top:2px;">
              ${esc(c.ex_t)}${c.ex_trans ? ` — ${esc(c.ex_trans)}` : ''}</div>` : ''}
          </div>`).join('');
      }
    })();
  </script>
</BaseLayout>
