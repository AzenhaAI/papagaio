---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Portuguese verb conjugator — PapaGaio"
  desc="Conjugate any European Portuguese verb: present, preterite, imperfect, future, conditional, all three subjunctives and the imperative — with the pt-PT forms Brazilian tables get wrong.">
  <h1>Verbs</h1>
  <p class="muted">
    Every form generated from the rules, with an explicit table where the rules
    break. European Portuguese throughout — including the ones Brazilian
    conjugators quietly drop, like the future subjunctive you need after
    <em>quando</em> and <em>se</em>.
  </p>

  <div style="display:flex; gap:10px; margin:18px 0;">
    <input id="q" type="search" placeholder="Type any verb — falar, pôr, abrandar…"
      style="flex:1; background:var(--panel2); color:var(--text); border:1px solid #2a4433;
             border-radius:10px; padding:10px 16px; font:inherit;" />
  </div>

  <div id="out"></div>
  <div id="index"></div>

  <script>
    const API = 'https://papagaio.kirshp.workers.dev/api/conjugate';
    const TTS = 'https://papagaio.kirshp.workers.dev/api/tts';
    const out = document.getElementById('out');
    const index = document.getElementById('index');
    let verbs = [];

    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const fold = (s) => String(s ?? '').toLowerCase()
      .normalize('NFD').replace(/[̀-ͯ]/g, '');

    const PERSONS = ['eu', 'tu', 'ele/ela', 'nós', 'eles/elas'];

    // [start%, end%, unreal] — position of the action on a past→future line
    // with "now" at 50. Faded bands are moods, not facts.
    const TL = {
      presente: [42, 58, 0],
      pps: [16, 26, 0],
      imperfeito: [6, 38, 0],
      ppc: [14, 50, 0],
      mais_que_perfeito: [2, 10, 0],
      imperfeito_conj: [6, 38, 1],
      futuro: [70, 92, 0],
      futuro_prox: [54, 68, 0],
      futuro_conj: [62, 88, 1],
      condicional: [56, 84, 1],
      imperativo: [50, 64, 1],
    };

    const timeline = (k) => {
      const t = TL[k];
      if (!t) return '';
      return `<div class="tl">
        <div class="tl-seg${t[2] ? ' unreal' : ''}" style="left:${t[0]}%; width:${t[1] - t[0]}%"></div>
        <div class="tl-now"><span>now</span></div>
      </div>`;
    };

    // Grouped the way a learner reaches for a form: first *when* did it happen,
    // then which mood. You know you mean yesterday long before you know whether
    // you need the conjuntivo, so time is the outer question.
    const GROUPS = [
      ['Past', [
        ['Indicative', [
          ['pps', 'Pretérito Perfeito Simples do Indicativo (PPS)', 'finished, at a point: ontem, no ano passado'],
          ['imperfeito', 'Pretérito Imperfeito do Indicativo (PII)', 'ongoing or habitual back then: antigamente'],
          ['ppc', 'Pretérito Perfeito Composto do Indicativo (PPC)', 'repetition reaching now: ultimamente tenho falado — NOT the English present perfect'],
          ['mais_que_perfeito', 'Pretérito Mais-que-Perfeito Composto (PMQP)', 'earlier than another past moment'],
        ]],
        ['Subjunctive', [
          ['imperfeito_conj', 'Pretérito Imperfeito do Conjuntivo (PIC)', 'after se: se eu tivesse…'],
        ]],
      ]],
      ['Present', [
        ['Indicative', [
          ['presente', 'Presente do Indicativo (PI)', 'now, and general truths: agora, hoje'],
        ]],
        ['Subjunctive', [
          ['presente_conj', 'Presente do Conjuntivo (PC)', 'after que, talvez, espero que…'],
        ]],
        ['Other', [
          ['condicional', 'Condicional Simples (COND)', 'would: eu gostaria, seria melhor'],
          ['imperativo', 'Imperativo (IMP)', 'telling someone to do it'],
        ]],
      ]],
      ['Future', [
        ['Indicative', [
          ['futuro_prox', 'Futuro Próximo — ir + infinitivo', 'the future people actually say: vou falar amanhã'],
          ['futuro', 'Futuro Simples do Indicativo (FS)', 'will — mostly written and formal'],
        ]],
        ['Subjunctive', [
          ['futuro_conj', 'Futuro do Conjuntivo (FC)', 'after quando, se, assim que — very pt-PT'],
        ]],
      ]],
    ];

    async function show(v) {
      out.innerHTML = '<p class="muted">conjugating…</p>';
      const d = await (await fetch(`${API}?v=${encodeURIComponent(v)}`)).json().catch(() => null);
      if (!d || d.error) {
        out.innerHTML = `<p class="muted">«${esc(v)}» is not a verb we can conjugate.
          Infinitives end in -ar, -er, -ir (and pôr).</p>`;
        return;
      }
      const c = d.conj;
      let html = `<div class="panel" style="padding:18px;">
        <div style="display:flex; align-items:baseline; gap:12px; flex-wrap:wrap;">
          <strong style="font-size:22px;">${esc(d.verb)}</strong>
          ${d.gloss ? `<span class="muted">${esc(d.gloss)}</span>` : ''}
          <button class="say" data-t="${esc(d.verb)}"
            style="background:none; border:0; cursor:pointer; font-size:17px;">🔊</button>
        </div>
        <div class="muted" style="font-size:13.5px; margin-top:4px;">
          particípio <strong>${esc(c.participio)}</strong> · gerúndio <strong>${esc(c.gerundio)}</strong>
        </div>
        <div class="grow" style="display:flex; gap:6px; margin:16px 0 12px; flex-wrap:wrap;">` +
        GROUPS.map(([name], g) =>
          `<button class="mood ${g === 1 ? 'on' : ''}" data-g="${g}">${name}</button>`).join('') +
        '</div>';

      GROUPS.forEach(([, moods], g) => {
        html += `<div class="moodpane" data-g="${g}" style="display:${g === 1 ? 'block' : 'none'};">`;
        for (const [mood, tenses] of moods) {
          // A mood heading with nothing under it is noise: prune both levels.
          if (!tenses.some(([k]) => c[k]?.length)) continue;
          html += `<div class="moodlabel">${mood}</div>`;
        for (const [k, name, when] of tenses) {
          if (!c[k]?.length) continue;
          html += `<div style="margin-bottom:16px;">
            <strong style="font-size:14.5px;">${name}</strong>
            <div class="muted" style="font-size:13px;">${when}</div>
            ${timeline(k)}
            <div style="background:var(--panel2); border-radius:10px; padding:10px 14px;
                 display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:3px 16px;">` +
            c[k].map((f, n) => f
              ? `<div style="font-size:14.5px; display:flex; align-items:center; gap:6px;">
                   <span class="muted" style="min-width:60px;">${PERSONS[n]}</span>
                   <span>${esc(f)}</span>
                   <button class="say" data-t="${esc(f)}"
                     style="background:none; border:0; cursor:pointer; font-size:13px; opacity:.6;">🔊</button>
                 </div>`
              : `<div style="font-size:14.5px;" class="muted">${PERSONS[n]} —</div>`).join('') +
            '</div></div>';
        }
        }
        html += '</div>';
      });
      out.innerHTML = html + '</div>';

      document.querySelectorAll('.mood').forEach((b) => {
        b.onclick = () => {
          document.querySelectorAll('.mood').forEach((x) => x.classList.toggle('on', x === b));
          document.querySelectorAll('.moodpane').forEach((p) => {
            p.style.display = p.dataset.g === b.dataset.g ? 'block' : 'none';
          });
        };
      });
      document.querySelectorAll('.say').forEach((b) => {
        b.onclick = async () => {
          const r = await fetch(TTS, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ text: b.dataset.t, course: 'pt' }),
          });
          if (r.ok) new Audio(URL.createObjectURL(await r.blob())).play();
        };
      });
      out.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    const ESSENTIALS = ['ser', 'ter', 'estar', 'ir', 'fazer', 'poder', 'dizer',
      'dar', 'ver', 'saber', 'querer', 'ficar', 'vir', 'falar', 'gostar', 'pôr'];

    function renderIndex(filter) {
      const q = fold(filter ?? '');
      const shown = q ? verbs.filter((v) => fold(v.inf).startsWith(q) || fold(v.gloss).includes(q)) : verbs;

      const ess = q ? [] : ESSENTIALS
        .map((e) => verbs.find((v) => v.inf === e)).filter(Boolean);
      const byLetter = {};
      for (const v of shown) (byLetter[fold(v.inf)[0].toUpperCase()] ??= []).push(v);

      index.innerHTML = (ess.length ? `<h2>The essentials</h2>
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(240px, 1fr)); gap:2px 18px; margin-bottom:8px;">` +
        ess.map((v) => `<button class="vrow" data-v="${esc(v.inf)}">
            <span><strong>${esc(v.inf)}</strong></span>
            <span class="muted">${esc(v.gloss)}</span>
          </button>`).join('') + '</div>' : '') +
        `<h2>All verbs <span class="muted" style="font-weight:400; font-size:15px;">
          · ${shown.length}</span></h2>` +
        Object.keys(byLetter).sort().map((L) => `
          <div style="margin-bottom:18px;">
            <div class="muted" style="font-size:13px; letter-spacing:.08em; margin-bottom:6px;">${L}</div>
            <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(240px, 1fr)); gap:2px 18px;">` +
            byLetter[L].map((v) =>
              `<button class="vrow" data-v="${esc(v.inf)}">
                 <span>${esc(v.inf)}</span>
                 <span class="muted">${esc(v.gloss)}</span>
               </button>`).join('') +
          '</div></div>').join('');

      index.querySelectorAll('.vrow').forEach((b) => { b.onclick = () => show(b.dataset.v); });
    }

    (async () => {
      const d = await (await fetch(`${API}?list`)).json();
      verbs = d.verbs;
      renderIndex('');
    })();

    const q = document.getElementById('q');
    q.addEventListener('input', () => renderIndex(q.value.trim()));
    // Enter conjugates whatever was typed, even a verb outside the list — the
    // rules do not care whether we thought to include it.
    q.addEventListener('keydown', (e) => { if (e.key === 'Enter' && q.value.trim()) show(q.value.trim()); });
  </script>
  <style is:global>
    .mood {
      background: var(--panel2); border: 0; border-radius: 8px; color: var(--muted);
      font: inherit; font-size: 14px; padding: 7px 18px; cursor: pointer;
    }
    .mood.on { background: var(--accent); color: #08130c; font-weight: 600; }
    .moodlabel {
      color: var(--muted); font-size: 11.5px; letter-spacing: .12em;
      text-transform: uppercase; font-weight: 600; margin: 4px 0 8px;
    }
    .vrow {
      display: flex; justify-content: space-between; gap: 12px; align-items: baseline;
      background: none; border: 0; border-bottom: 1px solid var(--panel2);
      color: var(--text); font: inherit; font-size: 15px; text-align: left;
      padding: 7px 4px; cursor: pointer; width: 100%;
    }
    .vrow:hover { background: var(--panel2); }
    .tl {
      position: relative; height: 16px; margin: 6px 0 8px; max-width: 340px;
    }
    .tl::before {
      content: ''; position: absolute; top: 7px; left: 0; right: 0; height: 2px;
      background: var(--panel2); border-radius: 1px;
    }
    .tl-seg {
      position: absolute; top: 5px; height: 6px; border-radius: 3px;
      background: var(--accent);
    }
    .tl-seg.unreal { opacity: .38; }
    .tl-now {
      position: absolute; left: 50%; top: 2px; width: 2px; height: 12px;
      background: var(--accent2);
    }
    .tl-now span {
      position: absolute; top: 13px; left: -12px; font-size: 9.5px;
      color: var(--muted); letter-spacing: .04em;
    }
    .vrow .muted { font-size: 13.5px; text-align: right; }
  </style>
</BaseLayout>
