---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Dictionary — PapaGaio">
  <h1>The deck</h1>
  <p class="muted">
    The shared frequency deck the bot teaches from. European Portuguese from A1
    (survival first, Madeira vocabulary included) and English from B1–B2.
    Every card has native-quality audio.
  </p>

  <div style="display:flex; gap:10px; margin: 18px 0; flex-wrap:wrap;">
    <button class="btn" data-course="pt" id="btn-pt">🇵🇹 Portuguese</button>
    <button class="btn" data-course="en" id="btn-en" style="background:var(--panel2); color:var(--text);">🇬🇧 English</button>
    <input id="q" type="search" placeholder="Search…"
      style="flex:1; min-width:180px; background:var(--panel2); color:var(--text); border:1px solid #2a4433;
             border-radius:10px; padding:8px 14px; font:inherit;" />
  </div>
  <div id="tags" style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:14px;"></div>

  <div id="list"></div>

  <script>
    const AUDIO = 'https://shpara.com/papagaio/audio/';
    const API = 'https://papagaio.kirshp.workers.dev/api/deck';
    const list = document.getElementById('list');
    let all = [];      // loaded cards of the current course
    let tag = null;    // active tag filter

    function render() {
      const q = document.getElementById('q').value.trim().toLowerCase();
      const cards = all.filter((c) =>
        (!tag || (c.tags ?? '').includes(`"${tag}"`)) &&
        (!q || c.term.toLowerCase().includes(q) || c.trans.toLowerCase().includes(q))
      );
      list.innerHTML = (cards.length ? cards : []).map((c, i) => `
        <div class="panel" style="margin-bottom:10px; padding:14px 18px; display:flex; align-items:baseline; gap:12px; flex-wrap:wrap;">
          <strong style="font-size:18px;">${c.term}</strong>
          ${c.gender ? `<span class="muted">(${c.gender})</span>` : ''}
          <span>— ${c.trans}</span>
          ${c.audio ? `<button onclick="new Audio('${AUDIO}${c.audio}').play()"
            style="background:none; border:0; cursor:pointer; font-size:17px;">🔊</button>` : ''}
          ${c.entry ? `<button class="morebtn" data-i="${i}"
            style="background:none; border:1px solid #2a4433; border-radius:8px; color:var(--accent);
                   cursor:pointer; font-size:13px; padding:2px 10px;">📖 more</button>` : ''}
          ${c.note ? `<div class="muted" style="width:100%; font-size:14px;">${c.note}</div>` : ''}
          ${c.ex_t ? `<div class="muted" style="width:100%; font-size:14px; font-style:italic;">${c.ex_t}</div>` : ''}
          ${c.entry ? `<div class="entrybox" id="e${i}" style="display:none; width:100%;"></div>` : ''}
        </div>`).join('') || '<p class="muted">Nothing matches.</p>';

      list.querySelectorAll('.morebtn').forEach((b) => {
        b.onclick = () => {
          const i = b.dataset.i;
          const box = document.getElementById('e' + i);
          if (box.style.display === 'none') { box.innerHTML = renderEntry(JSON.parse(cards[i].entry)); box.style.display = 'block'; }
          else box.style.display = 'none';
        };
      });
    }

    const PERSONS = ['eu', 'tu', 'ele/ela', 'nós', 'eles/elas'];
    const TENSES = { presente: 'Presente', pps: 'Pretérito perfeito', imperfeito: 'Imperfeito' };

    function renderEntry(e) {
      let h = '';
      if (e.meanings?.length) h += '<ol style="margin:10px 0 0; padding-left:20px;">' +
        e.meanings.map((m) => `<li>${m.trans}${m.note ? ` <span class="muted">— ${m.note}</span>` : ''}</li>`).join('') + '</ol>';
      if (e.conj) {
        h += '<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(170px, 1fr)); gap:12px; margin-top:12px;">';
        for (const [t, name] of Object.entries(TENSES)) {
          if (!e.conj[t]) continue;
          h += `<div style="background:var(--panel2); border-radius:10px; padding:10px 14px;">
            <strong style="font-size:13.5px;">${name}</strong>` +
            e.conj[t].map((f, i) => `<div style="font-size:14px;"><span class="muted">${PERSONS[i]}</span> ${f}</div>`).join('') +
            '</div>';
        }
        h += '</div>';
      }
      if (e.collocations?.length) h += '<div style="margin-top:12px;">' +
        e.collocations.map((c) => `<div style="font-size:14.5px;"><code style="color:var(--accent)">${c.t}</code> <span class="muted">— ${c.trans}</span></div>`).join('') + '</div>';
      if (e.synonyms?.length) h += `<div class="muted" style="margin-top:10px; font-size:14px;">≈ ${e.synonyms.join(', ')}</div>`;
      if (e.grammar) h += `<div class="muted" style="margin-top:10px; font-size:14px;">ℹ️ ${e.grammar}</div>`;
      if (e.lit?.length) h += e.lit.map((l) =>
        `<div style="margin-top:10px; font-size:14.5px; font-style:italic;">💬 ${l.text}<br /><span class="muted" style="font-style:normal;">— ${l.src}</span></div>`).join('');
      return h;
    }

    function renderTags() {
      const counts = {};
      all.forEach((c) => JSON.parse(c.tags ?? '[]').forEach((t) => { counts[t] = (counts[t] ?? 0) + 1; }));
      const box = document.getElementById('tags');
      box.innerHTML = Object.entries(counts).sort((a, b) => b[1] - a[1]).map(([t, n]) =>
        `<button class="tagbtn" data-t="${t}" style="background:${tag === t ? 'var(--accent)' : 'var(--panel2)'};
          color:${tag === t ? '#08130c' : 'var(--muted)'}; border:0; border-radius:16px; padding:4px 12px;
          font:inherit; font-size:13px; cursor:pointer;">${t} · ${n}</button>`).join('');
      box.querySelectorAll('.tagbtn').forEach((b) => {
        b.onclick = () => { tag = tag === b.dataset.t ? null : b.dataset.t; renderTags(); render(); };
      });
    }

    async function load(course) {
      document.getElementById('btn-pt').style.cssText = course === 'pt' ? '' : 'background:var(--panel2); color:var(--text)';
      document.getElementById('btn-en').style.cssText = course === 'en' ? '' : 'background:var(--panel2); color:var(--text)';
      list.innerHTML = '<p class="muted">loading…</p>';
      const r = await fetch(`${API}?course=${course}&limit=500`);
      all = (await r.json()).cards;
      tag = null;
      renderTags();
      render();
    }
    document.getElementById('q').addEventListener('input', render);
    document.getElementById('btn-pt').onclick = () => load('pt');
    document.getElementById('btn-en').onclick = () => load('en');
    load('pt');
  </script>
</BaseLayout>
