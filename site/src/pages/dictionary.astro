---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Dictionary — PapaGaio">
  <h1>The deck</h1>
  <p class="muted">
    The shared frequency deck the bot teaches from. European Portuguese from A1
    (survival first, Madeira vocabulary included) and English from B1–B2.
    Every card has native-quality audio.
  </p>
  <p class="muted" style="font-size:13.5px;">
    Search anything, not just what the deck teaches: 18,699 further headwords sit
    behind it, and words neither knows are looked up live. Lexicon from
    <a href="https://en.wiktionary.org/">English Wiktionary</a> (CC BY-SA 4.0),
    ranked by an <a href="https://github.com/hermitdave/FrequencyWords">OpenSubtitles
    frequency list</a> (CC BY-SA 4.0).
  </p>

  <div style="display:flex; gap:10px; margin: 18px 0; flex-wrap:wrap;">
    <button class="btn" data-course="pt" id="btn-pt">🇵🇹 Portuguese</button>
    <button class="btn" data-course="en" id="btn-en" style="background:var(--panel2); color:var(--text);">🇬🇧 English</button>
    <input id="q" type="search" placeholder="Search…"
      style="flex:1; min-width:180px; background:var(--panel2); color:var(--text); border:1px solid #2a4433;
             border-radius:10px; padding:8px 14px; font:inherit;" />
  </div>
  <div id="tags" style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:14px;"></div>

  <div id="histbox" style="display:none; margin-bottom:16px;">
    <div style="display:flex; align-items:baseline; gap:10px; margin-bottom:8px;">
      <strong style="font-size:14.5px;">Recently opened</strong>
      <button id="histclear" class="muted"
        style="background:none; border:0; font:inherit; font-size:13px; cursor:pointer; text-decoration:underline;">clear</button>
    </div>
    <div id="histstrip" style="display:flex; gap:8px; overflow-x:auto; padding-bottom:6px;"></div>
  </div>

  <div id="list"></div>

  <script>
    const AUDIO = 'https://shpara.com/papagaio/audio/';
    const API = 'https://papagaio.kirshp.workers.dev/api/deck';
    const LOOKUP = 'https://papagaio.kirshp.workers.dev/api/lookup';
    const SEARCH = 'https://papagaio.kirshp.workers.dev/api/search';
    const TTS = 'https://papagaio.kirshp.workers.dev/api/tts';
    const list = document.getElementById('list');
    let all = [];      // loaded cards of the current course
    let tag = null;    // active tag filter

    // Searching "cafe" must find "café": nobody reaches for the accent key, and
    // Portuguese puts one on a great many words.
    const fold = (x) => String(x ?? '').toLowerCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '');

    function render() {
      const q = fold(document.getElementById('q').value.trim());
      const cards = all.filter((c) =>
        (!tag || (c.tags ?? '').includes(`"${tag}"`)) &&
        (!q || fold(c.term).includes(q) || fold(c.trans).includes(q) || fold(c.note).includes(q))
      );
      list.innerHTML = (cards.length ? cards : []).map((c, i) => `
        <div class="panel" style="margin-bottom:10px; padding:14px 18px; display:flex; align-items:baseline; gap:12px; flex-wrap:wrap;">
          <strong style="font-size:18px;">${c.term}</strong>
          ${c.gender ? `<span class="muted">(${c.gender})</span>` : ''}
          <span>— ${c.trans}</span>
          ${c.audio ? `<button onclick="new Audio('${AUDIO}${c.audio}').play()"
            style="background:none; border:0; cursor:pointer; font-size:17px;">🔊</button>` : ''}
          ${c.entry ? `<button class="morebtn" data-i="${i}"
            style="background:none; border:1px solid #2a4433; border-radius:8px; color:var(--accent);
                   cursor:pointer; font-size:13px; padding:2px 10px;">📖 more</button>` : ''}
          ${c.note ? `<div class="muted" style="width:100%; font-size:14px;">${c.note}</div>` : ''}
          ${c.ex_t ? `<div class="muted" style="width:100%; font-size:14px; font-style:italic;">${c.ex_t}</div>` : ''}
          ${c.entry ? `<div class="entrybox" id="e${i}" style="display:none; width:100%;"></div>` : ''}
        </div>`).join('') || missHtml(q);

      // A miss in the deck goes straight to the 18k-word lexicon rather than
      // making the learner press a button to be allowed to look something up.
      if (!cards.length && q) suggest(document.getElementById('q').value.trim());

      list.querySelectorAll('.morebtn').forEach((b) => {
        b.onclick = () => {
          const i = b.dataset.i;
          remember(cards[i]);
          const box = document.getElementById('e' + i);
          if (box.style.display === 'none') { box.innerHTML = renderEntry(JSON.parse(cards[i].entry), cards[i], i); box.style.display = 'block'; wireTabs(i); }
          else box.style.display = 'none';
        };
      });
    }

    // The deck is 400 words; Portuguese is not. A word we don't teach is still a
    // word you met on a sign this morning, so a miss offers a live lookup rather
    // than a dead end.
    function missHtml(q) {
      return q ? '<p class="muted">searching the dictionary…</p>'
               : '<p class="muted">Nothing matches.</p>';
    }

    let suggestSeq = 0;
    async function suggest(q) {
      const mine = ++suggestSeq;
      let d;
      try {
        d = await (await fetch(`${SEARCH}?q=${encodeURIComponent(q)}`)).json();
      } catch {
        d = null;
      }
      // Typing is faster than the network: only the newest query may paint.
      if (mine !== suggestSeq) return;
      if (!d?.words?.length) {
        list.innerHTML = `<div class="panel" style="text-align:center; padding:26px 18px;">
          <p class="muted" style="margin:0 0 14px;">Not in the deck or the dictionary.</p>
          <button class="btn" id="lookbtn">🔎 Look «${esc(q)}» up anyway</button>
        </div>`;
        document.getElementById('lookbtn').onclick = () => lookup(q);
        return;
      }
      list.innerHTML = `<p class="muted" style="font-size:14px;">
          Not taught by the deck — found in the dictionary:</p>` +
        d.words.map((w) => `
          <button class="lexrow" data-t="${esc(w.term)}">
            <span><strong>${esc(w.term)}</strong>
              <span class="muted" style="font-size:13px;"> ${esc(w.pos ?? '')}${w.gender ? ' ' + esc(w.gender) : ''}</span>
            </span>
            <span class="muted">${esc(w.trans).slice(0, 90)}</span>
          </button>`).join('');
      list.querySelectorAll('.lexrow').forEach((b) => { b.onclick = () => lookup(b.dataset.t); });
    }

    async function lookup(q) {
      list.innerHTML = '<p class="muted">looking it up…</p>';
      let d;
      try {
        d = await (await fetch(`${LOOKUP}?q=${encodeURIComponent(q)}`)).json();
      } catch {
        d = { error: 'network' };
      }
      if (!d || d.error || !d.card) {
        list.innerHTML = `<p class="muted">No entry for «${esc(q)}».</p>`;
        return;
      }
      const c = d.card;
      // The conjugator is the authority on forms, so its table wins over any the
      // article happens to carry.
      const e = c.entry ?? { meanings: [], synonyms: [], collocations: [], grammar: '', conj: {} };
      if (d.conj) e.conj = d.conj;
      remember({ ...c, course: c.course ?? 'pt' });

      list.innerHTML = `
        <div class="panel" style="padding:16px 18px;">
          <div style="display:flex; align-items:baseline; gap:12px; flex-wrap:wrap;">
            <strong style="font-size:20px;">${esc(c.term)}</strong>
            ${c.gender ? `<span class="muted">(${esc(c.gender)})</span>` : ''}
            <span>— ${esc(c.trans)}</span>
            <button id="saybtn" style="background:none; border:0; cursor:pointer; font-size:17px;">🔊</button>
            ${d.source === 'lookup' ? '<span class="muted" style="font-size:12.5px;">looked up live</span>' : ''}
          </div>
          ${c.note ? `<div class="muted" style="font-size:14px;">${esc(c.note)}</div>` : ''}
          ${c.ex_t ? `<div class="muted" style="font-size:14px; font-style:italic;">${esc(c.ex_t)}</div>` : ''}
          <div id="e-look"></div>
        </div>`;
      document.getElementById('e-look').innerHTML = renderEntry(e, c, 'look');
      wireTabs('look');
      document.getElementById('saybtn').onclick = async () => {
        const r = await fetch(TTS, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ text: c.term, course: 'pt' }),
        });
        if (r.ok) new Audio(URL.createObjectURL(await r.blob())).play();
      };
    }

    const PERSONS = ['eu', 'tu', 'ele/ela', 'nós', 'eles/elas'];
    // Grouped the way a learner reaches for them: when did it happen?
    const TENSE_GROUPS = [
      ['Past', [
        ['pps', 'Pretérito Perfeito', 'finished, at a point: ontem, no ano passado'],
        ['imperfeito', 'Pretérito Imperfeito', 'ongoing or habitual back then: antigamente, sempre'],
        ['mais_que_perfeito', 'Mais-que-perfeito Composto', 'earlier than another past moment'],
        ['imperfeito_conj', 'Imperfeito do Conjuntivo', 'after se: se eu tivesse…'],
      ]],
      ['Present', [
        ['presente', 'Presente do Indicativo', 'now, and general truths: agora, hoje'],
        ['presente_conj', 'Presente do Conjuntivo', 'after que, talvez, espero que…'],
        ['condicional', 'Condicional', 'would: eu gostaria, seria melhor'],
        ['imperativo', 'Imperativo', 'telling someone to do it'],
      ]],
      ['Future', [
        ['futuro', 'Futuro do Indicativo', 'will: amanhã, para o ano'],
        ['futuro_conj', 'Futuro do Conjuntivo', 'after quando, se, assim que — very pt-PT'],
      ]],
    ];

    // Looking a word up is the signal worth keeping — not merely scrolling past it.
    const HKEY = 'pg_dict_history';
    const hist = () => { try { return JSON.parse(localStorage.getItem(HKEY) ?? '[]'); } catch { return []; } };

    function remember(c) {
      if (!c) return;
      const entry = { id: c.id, term: c.term, trans: c.trans, course: c.course };
      const next = [entry, ...hist().filter((x) => x.id !== c.id)].slice(0, 12);
      localStorage.setItem(HKEY, JSON.stringify(next));
      renderHist();
    }

    function renderHist() {
      const h = hist();
      document.getElementById('histbox').style.display = h.length ? 'block' : 'none';
      document.getElementById('histstrip').innerHTML = h.map((x) => `
        <button class="histchip" data-id="${x.id}" title="${esc(x.trans)}">
          <span style="font-weight:600;">${esc(x.term)}</span>
          <span class="muted" style="font-size:12.5px;">${esc(x.trans).slice(0, 28)}</span>
        </button>`).join('');
      document.querySelectorAll('.histchip').forEach((b) => {
        b.onclick = () => {
          // Jump to the word: clear filters so it cannot be hidden, then open it.
          tag = null;
          document.getElementById('q').value = '';
          renderTags();
          render();
          const card = all.find((c) => c.id === b.dataset.id);
          if (!card) return;
          document.getElementById('q').value = card.term;
          render();
          const more = document.querySelector('.morebtn');
          if (more) more.click();
          document.getElementById('list').scrollIntoView({ behavior: 'smooth', block: 'start' });
        };
      });
    }

    document.getElementById('histclear').onclick = () => {
      localStorage.removeItem(HKEY);
      renderHist();
    };

    // Tabs rather than one long scroll: meanings, usage and conjugation are
    // three different questions, and you arrive with only one of them.
    function renderEntry(e, card, i) {
      const panes = [];

      let dict = '';
      if (e.meanings?.length) dict += '<ol style="margin:10px 0 0; padding-left:20px;">' +
        e.meanings.map((m) => `<li>${m.trans}${m.note ? ` <span class="muted">— ${m.note}</span>` : ''}</li>`).join('') + '</ol>';
      if (e.synonyms?.length) dict += '<div style="margin-top:12px; display:flex; gap:6px; flex-wrap:wrap;">' +
        e.synonyms.map((x) => `<span class="syn">${esc(x)}</span>`).join('') + '</div>';
      if (e.collocations?.length) dict += '<div style="margin-top:12px;">' +
        e.collocations.map((c) => `<div style="font-size:14.5px;"><code style="color:var(--accent)">${esc(c.t)}</code> <span class="muted">— ${esc(c.trans)}</span></div>`).join('') + '</div>';
      if (e.grammar) dict += `<div class="muted" style="margin-top:12px; font-size:14px;">ℹ️ ${esc(e.grammar)}</div>`;
      if (dict) panes.push(['Dictionary', dict]);

      let ex = '';
      const line = (pt, en) => `<div style="margin-bottom:12px;">
        <div style="font-size:15.5px;">${esc(pt)}</div>
        ${en ? `<div class="muted" style="font-size:14px;">${esc(en)}</div>` : ''}</div>`;
      if (card?.ex_t) ex += line(card.ex_t, card.ex_trans);
      if (e.collocations?.length) ex += e.collocations.map((c) => line(c.t, c.trans)).join('');
      if (e.lit?.length) ex += e.lit.map((l) =>
        `<div style="margin-top:10px; font-size:14.5px; font-style:italic;">💬 ${esc(l.text)}<br />
         <span class="muted" style="font-style:normal;">— ${esc(l.src)}</span></div>`).join('');
      if (ex) panes.push(['Examples', ex]);

      if (e.conj) {
        const groups = TENSE_GROUPS
          .map(([label, tenses]) => [label, tenses.filter(([k]) => e.conj[k]?.length)])
          .filter(([, tenses]) => tenses.length);
        if (groups.length) {
          let cj = `<div class="timerow" style="display:flex; gap:4px; margin-bottom:12px;">` +
            groups.map(([label], g) =>
              `<button class="time ${g === 0 ? 'on' : ''}" data-i="${i}" data-g="${g}">${label}</button>`).join('') +
            '</div>';
          groups.forEach(([, tenses], g) => {
            cj += `<div class="timepane" data-i="${i}" data-g="${g}" style="display:${g === 0 ? 'block' : 'none'};">`;
            for (const [k, name, when] of tenses) {
              cj += `<div style="margin-bottom:14px;">
                <strong style="font-size:14.5px;">${name}</strong>
                ${when ? `<div class="muted" style="font-size:13px; margin-bottom:5px;">${when}</div>` : ''}
                <div style="background:var(--panel2); border-radius:10px; padding:10px 14px;
                     display:grid; grid-template-columns:repeat(auto-fit, minmax(130px, 1fr)); gap:2px 16px;">` +
                e.conj[k].map((f, n) => f
                  ? `<div style="font-size:14.5px;"><span class="muted">${PERSONS[n]}</span> ${esc(f)}</div>`
                  : `<div style="font-size:14.5px;" class="muted">${PERSONS[n]} —</div>`).join('') +
                '</div></div>';
            }
            cj += '</div>';
          });
          panes.push(['Conjugations', cj]);
        }
      }

      if (!panes.length) return '';
      if (panes.length === 1) return `<div style="margin-top:10px;">${panes[0][1]}</div>`;

      return `<div class="tabrow" data-i="${i}" style="display:flex; gap:6px; margin:12px 0 10px; flex-wrap:wrap;">` +
        panes.map(([name], n) => `<button class="tab ${n === 0 ? 'on' : ''}" data-i="${i}" data-n="${n}">${name}</button>`).join('') +
        '</div>' +
        panes.map(([, html], n) =>
          `<div class="pane" data-i="${i}" data-n="${n}" style="display:${n === 0 ? 'block' : 'none'};">${html}</div>`).join('');
    }

    function wireTabs(i) {
      document.querySelectorAll(`.time[data-i="${i}"]`).forEach((b) => {
        b.onclick = () => {
          document.querySelectorAll(`.time[data-i="${i}"]`).forEach((x) => x.classList.toggle('on', x === b));
          document.querySelectorAll(`.timepane[data-i="${i}"]`).forEach((pane) => {
            pane.style.display = pane.dataset.g === b.dataset.g ? 'block' : 'none';
          });
        };
      });
      document.querySelectorAll(`.tab[data-i="${i}"]`).forEach((b) => {
        b.onclick = () => {
          document.querySelectorAll(`.tab[data-i="${i}"]`).forEach((x) => x.classList.toggle('on', x === b));
          document.querySelectorAll(`.pane[data-i="${i}"]`).forEach((pane) => {
            pane.style.display = pane.dataset.n === b.dataset.n ? 'block' : 'none';
          });
        };
      });
    }

    function renderTags() {
      const counts = {};
      all.forEach((c) => JSON.parse(c.tags ?? '[]').forEach((t) => { counts[t] = (counts[t] ?? 0) + 1; }));
      const box = document.getElementById('tags');
      box.innerHTML = Object.entries(counts).sort((a, b) => b[1] - a[1]).map(([t, n]) =>
        `<button class="tagbtn" data-t="${t}" style="background:${tag === t ? 'var(--accent)' : 'var(--panel2)'};
          color:${tag === t ? '#08130c' : 'var(--muted)'}; border:0; border-radius:16px; padding:4px 12px;
          font:inherit; font-size:13px; cursor:pointer;">${t} · ${n}</button>`).join('');
      box.querySelectorAll('.tagbtn').forEach((b) => {
        b.onclick = () => { tag = tag === b.dataset.t ? null : b.dataset.t; renderTags(); render(); };
      });
    }

    async function load(course) {
      document.getElementById('btn-pt').style.cssText = course === 'pt' ? '' : 'background:var(--panel2); color:var(--text)';
      document.getElementById('btn-en').style.cssText = course === 'en' ? '' : 'background:var(--panel2); color:var(--text)';
      list.innerHTML = '<p class="muted">loading…</p>';
      const r = await fetch(`${API}?course=${course}&limit=500`);
      all = (await r.json()).cards;
      tag = null;
      renderTags();
      render();
    }
    renderHist();
    document.getElementById('q').addEventListener('input', render);
    document.getElementById('btn-pt').onclick = () => load('pt');
    document.getElementById('btn-en').onclick = () => load('en');
    load('pt');
  </script>
  <style>
    .histchip {
      display: flex; flex-direction: column; align-items: flex-start; gap: 1px;
      background: var(--panel); border: 1px solid var(--panel2); border-radius: 12px;
      padding: 8px 14px; font: inherit; font-size: 14.5px; color: var(--text);
      cursor: pointer; white-space: nowrap; flex: none;
    }
    .histchip:hover { border-color: var(--accent); }
    .lexrow {
      display: flex; justify-content: space-between; gap: 14px; align-items: baseline;
      width: 100%; background: none; border: 0; border-bottom: 1px solid var(--panel2);
      color: var(--text); font: inherit; font-size: 15px; text-align: left;
      padding: 9px 4px; cursor: pointer;
    }
    .lexrow:hover { background: var(--panel2); }
    .lexrow .muted { font-size: 13.5px; text-align: right; }
    .tab {
      background: none; border: 0; border-bottom: 2px solid transparent; color: var(--muted);
      font: inherit; font-size: 14.5px; padding: 5px 2px; margin-right: 12px; cursor: pointer;
    }
    .tab.on { color: var(--text); border-bottom-color: var(--accent); font-weight: 600; }
    .time {
      background: var(--panel2); border: 0; border-radius: 8px; color: var(--muted);
      font: inherit; font-size: 13.5px; padding: 6px 14px; cursor: pointer; flex: 1;
    }
    .time.on { background: var(--accent); color: #08130c; font-weight: 600; }
    .syn {
      background: var(--panel2); border-radius: 14px; padding: 3px 11px;
      font-size: 13.5px; color: var(--accent2);
    }
  </style>
</BaseLayout>
