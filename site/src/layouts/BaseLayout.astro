  <script is:inline>
    /* On a phone every tool page opened with its explanation: between 27 and 87
       words before the first field, which on a small screen pushed the tool itself
       off the bottom. The heading stays put and the prose folds behind it, so the
       page opens on the thing it is for. Desktop is untouched — there is room there.
       Written without ?. or ?? on purpose: one such token would throw on an older
       Safari and take the whole script with it. */
    (function () {
      if (window.innerWidth > 860) return;
      var main = document.querySelector('main');
      if (!main) return;
      var kids = Array.prototype.slice.call(main.children);
      // [data-unfold] marks content that must stay in view, like the store
      // badges on the apps page: links, not controls, but the point of the page.
      var interactive = 'input, textarea, select, button, [data-unfold]';
      var idx = -1;
      for (var i = 0; i < kids.length; i++) {
        var k = kids[i];
        if (k.matches && k.matches(interactive)) { idx = i; break; }
        if (k.querySelector && k.querySelector(interactive)) { idx = i; break; }
      }
      if (idx < 1) return;
      var start = (kids[0] && kids[0].tagName === 'H1') ? 1 : 0;
      var intro = kids.slice(start, idx);
      if (!intro.length) return;
      var words = 0;
      for (var j = 0; j < intro.length; j++) {
        var t = (intro[j].textContent || '').trim();
        if (t) words += t.split(/\s+/).length;
      }
      if (words < 25) return;
      var d = document.createElement('details');
      d.className = 'intro-fold';
      var sum = document.createElement('summary');
      sum.textContent = 'What this page is';
      sum.setAttribute('data-t', '');
      d.appendChild(sum);
      main.insertBefore(d, intro[0]);
      for (var n = 0; n < intro.length; n++) d.appendChild(intro[n]);
    })();

    /* The strip scrolls, so on a section further along it opens showing the first
       links and not the one you are on. Bring the current section into view. */
    (function () {
      var nav = document.querySelector('header.site nav');
      // Only a strip that actually overflows scrolls; desktop can too now.
      if (!nav || nav.scrollWidth <= nav.clientWidth) return;
      var cur = nav.querySelector('a.active');
      if (!cur) return;
      /* offsetLeft is measured against the nearest positioned ancestor, which is
         not this strip — using it put the active link half off the left edge.
         Actual rectangles say where things really are. */
      var navBox = nav.getBoundingClientRect();
      var curBox = cur.getBoundingClientRect();
      var delta = (curBox.left - navBox.left) - (navBox.width - curBox.width) / 2;
      nav.scrollLeft = nav.scrollLeft + delta;
    })();
  </script>

