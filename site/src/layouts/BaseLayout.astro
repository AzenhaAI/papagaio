---
const { title = 'PapaGaio — AI Coach for European Portuguese', desc = 'A live AI conversation coach for European Portuguese (pt-PT): roleplay the caf\u00e9, the bank, AIMA — it hears you, talks back and corrects you. Plus a pt-PT translator, reader and flashcards. Free forever.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), 'https://azenha.ai').href;
// The current section lights up in the nav — computed at build time from the
// page's own path, so every page gets it for free.
const here = Astro.url.pathname.replace(/\/$/, '');
const active = (p) => here.endsWith(`/${p}`) ? 'active' : '';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <!-- PapaGaio is still in testing — keep it out of search until it ships.
       Remove this line to make the whole section indexable again. -->
  <meta name="robots" content="noindex, follow" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={`${base}/icon.svg`} type="image/svg+xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://azenha.ai/papagaio/og.png" />
  <meta name="twitter:card" content="summary" />
  <meta property="og:url" content={canonical} />
  {import.meta.env.PROD && (
    <>
      {/* Cloudflare Web Analytics is cookieless and injected by Pages itself —
          enabled per-project in the dashboard, no beacon tag needed here. */}
      {/* GA4 stays parked behind consent: EU visitors must opt in first. */}
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        if (localStorage.getItem('pg_consent') === 'yes') {
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-M2PTQLF903';
          document.head.appendChild(s);
          gtag('js', new Date());
          gtag('config', 'G-M2PTQLF903');
        }
      </script>
    </>
  )}
  <script is:inline>
    // Theme before first paint — no flash.
    const saved = localStorage.getItem('pg_theme');
    if (saved) document.documentElement.dataset.theme = saved;
  </script>
  <style is:global>
    /* Portuguese flag palette: green and red, with the flag's own gold between them. */
    :root {
      --bg: #0e1a14;
      --panel: #16241c;
      --panel2: #1c2e23;
      --text: #e8f2ea;
      --muted: #8fa898;
      --accent: #34d17b;
      --accent2: #ffc857;
      --red: #e8453c;
      --warn: #ff9d5c;
      --radius: 14px;
      --max: 880px;
    }
    :root[data-theme="light"] {
      --bg: #f4f8f4;
      --panel: #ffffff;
      --panel2: #e9f1ea;
      --text: #14261a;
      --muted: #5b7263;
      --accent: #1f9d58;
      --accent2: #b8860b;
      --red: #c8102e;
      --warn: #c05621;
    }
    /* The flag's own 2:3 proportion, as a hairline across the top. */
    body::before {
      content: '';
      position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 70;
      background: linear-gradient(to right, var(--accent) 0 40%, var(--red) 40% 100%);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; background: var(--bg); color: var(--text);
      font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    header.site {
      max-width: var(--max); margin: 0 auto; padding: 20px 20px 0;
      display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    }
    header.site .logo { font-size: 26px; font-weight: 700; color: var(--accent); }
    header.site .logo span { color: var(--red); }
    header.site nav { display: flex; gap: 18px; margin-left: auto; }
    header.site nav a { color: var(--muted); font-size: 15px; white-space: nowrap; }
    header.site nav a:hover { color: var(--text); text-decoration: none; }
    header.site nav a.active {
      color: var(--text); font-weight: 600;
      border-bottom: 2px solid var(--accent); padding-bottom: 2px;
    }
    header.site { flex-wrap: nowrap; }
    /* Eight links do not fit a phone side by side, but hiding them outright left
       the header empty and every section a tap away behind the burger. They stay,
       as a strip that scrolls sideways and fades out before the burger; the burger
       keeps the full list, including what the strip has no room for. */
    @media (max-width: 860px) {
      header.site { flex-wrap: nowrap; gap: 10px; }
      header.site nav {
        margin-left: 0; flex: 1 1 auto; min-width: 0; gap: 14px;
        overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
        -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 26px), transparent 100%);
                mask-image: linear-gradient(to right, #000 calc(100% - 26px), transparent 100%);
      }
      header.site nav::-webkit-scrollbar { display: none; }
      header.site nav a { font-size: 14px; }
      header.site .logo { font-size: 21px; flex: 0 0 auto; }
      header.site #burger { margin-left: 0; flex: 0 0 auto; }
    }
    header.site #burger { margin-left: 4px; }
    main { max-width: var(--max); margin: 0 auto; padding: 28px 20px 60px; }
    .intro-fold { margin: 0 0 18px; }
    .intro-fold > summary {
      cursor: pointer; list-style: none; color: var(--muted); font-size: 14px;
      padding: 7px 0; border-bottom: 1px solid var(--panel2);
    }
    .intro-fold > summary::-webkit-details-marker { display: none; }
    .intro-fold > summary::after { content: ' ▾'; }
    .intro-fold[open] > summary::after { content: ' ▴'; }
    .intro-fold[open] > summary { margin-bottom: 10px; }
    footer.site {
      max-width: var(--max); margin: 0 auto; padding: 24px 20px 40px;
      color: var(--muted); font-size: 13.5px; border-top: 1px solid var(--panel2);
    }
    .panel { background: var(--panel); border-radius: var(--radius); padding: 22px; }
    .btn {
      display: inline-block; background: var(--accent); color: #08130c;
      font-weight: 600; padding: 10px 20px; border-radius: 10px; border: 0;
      font-size: 16px; cursor: pointer;
    }
    .btn:hover { filter: brightness(1.08); text-decoration: none; }
    .muted { color: var(--muted); }
    h1 { font-size: 30px; line-height: 1.25; margin: 0 0 10px; }
    h2 { font-size: 21px; margin: 34px 0 12px; }
  </style>
</head>
<body>
  <header class="site">
    <a class="logo" href={`${base}/`}>Papa<span>Gaio</span></a>
    <nav>
      <a class={active('coach')} href={`${base}/coach/`}>AI Coach</a>
      <a class={active('practice')} href={`${base}/practice/`}>Cards</a>
      <a class={active('translate')} href={`${base}/translate/`}>Translate</a>
      <a class={active('dictionary')} href={`${base}/dictionary/`}>Dictionary</a>
      <a class={active('phrasebook')} href={`${base}/phrasebook/`}>Phrasebook</a>
      <a class={active('verbs')} href={`${base}/verbs/`}>Verbs</a>
      <a class={active('progress')} href={`${base}/progress/`}>Progress</a>
      <a href="https://t.me/papagaio_ebot">Telegram bot</a>
    </nav>
    <button id="burger" aria-label="Menu" style="background:none; border:0; color:var(--text); font-size:24px; cursor:pointer; padding:4px 8px;">☰</button>
  </header>

  <div id="drawer-overlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:40;"></div>
  <aside id="drawer" style="position:fixed; top:0; right:-290px; width:280px; height:100vh; background:var(--panel);
    z-index:50; transition:right .25s ease; padding:22px; display:flex; flex-direction:column; gap:4px; box-shadow:-8px 0 30px rgba(0,0,0,.35);">
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
      <strong style="font-size:18px;">Menu</strong>
      <button id="drawer-close" aria-label="Close" style="background:none; border:0; color:var(--muted); font-size:22px; cursor:pointer;">✕</button>
    </div>
    <a class="drawer-link" href={`${base}/?home`}>🏠 Home</a>
    <a class="drawer-link" href={`${base}/translate/`}>🔤 Translator</a>
    <a class="drawer-link" href={`${base}/practice/`}>🎴 Practice</a>
    <a class="drawer-link" href={`${base}/coach/`}>🎭 AI coach</a>
    <a class="drawer-link" href={`${base}/read/`}>📰 Reader</a>
    <a class="drawer-link" href={`${base}/dictionary/`}>📖 Dictionary</a>
    <a class="drawer-link" href={`${base}/phrasebook/`}>💬 Phrasebook</a>
    <a class="drawer-link" href={`${base}/verbs/`}>🔀 Verbs</a>
    <a class="drawer-link" href={`${base}/progress/`}>📊 Progress</a>
    <a class="drawer-link" href={`${base}/about/`}>ℹ️ About</a>
    <a class="drawer-link" href="https://t.me/papagaio_ebot">✈️ Telegram bot</a>
    <hr style="border:0; border-top:1px solid var(--panel2); margin:10px 0;" />
    <button id="theme-toggle" class="drawer-link" style="background:none; border:0; font:inherit; text-align:left; cursor:pointer; width:100%;">🌗 Theme: <span id="theme-name">dark</span></button>
    <hr style="border:0; border-top:1px solid var(--panel2); margin:10px 0;" />
    <a class="drawer-link" href="mailto:agent@azenha.ai">✉️ Contact</a>
    <hr style="border:0; border-top:1px solid var(--panel2); margin:10px 0;" />
    <a class="drawer-link" href={`${base}/apps/`}>⬇️ Apps — Android · iPhone · Mac · Windows</a>
  </aside>
  <main><slot /></main>

  <script is:inline>
    /* On a phone every tool page opened with its explanation: between 27 and 87
       words before the first field, which on a small screen pushed the tool itself
       off the bottom. The heading stays put and the prose folds behind it, so the
       page opens on the thing it is for. Desktop is untouched — there is room there.
       Written without ?. or ?? on purpose: one such token would throw on an older
       Safari and take the whole script with it. */
    (function () {
      if (window.innerWidth > 860) return;
      var main = document.querySelector('main');
      if (!main) return;
      var kids = Array.prototype.slice.call(main.children);
      var interactive = 'input, textarea, select, button';
      var idx = -1;
      for (var i = 0; i < kids.length; i++) {
        var k = kids[i];
        if (k.matches && k.matches(interactive)) { idx = i; break; }
        if (k.querySelector && k.querySelector(interactive)) { idx = i; break; }
      }
      if (idx < 1) return;
      var start = (kids[0] && kids[0].tagName === 'H1') ? 1 : 0;
      var intro = kids.slice(start, idx);
      if (!intro.length) return;
      var words = 0;
      for (var j = 0; j < intro.length; j++) {
        var t = (intro[j].textContent || '').trim();
        if (t) words += t.split(/\s+/).length;
      }
      if (words < 25) return;
      var d = document.createElement('details');
      d.className = 'intro-fold';
      var sum = document.createElement('summary');
      sum.textContent = 'What this page is';
      d.appendChild(sum);
      main.insertBefore(d, intro[0]);
      for (var n = 0; n < intro.length; n++) d.appendChild(intro[n]);
    })();

    /* The strip scrolls, so on a section further along it opens showing the first
       links and not the one you are on. Bring the current section into view. */
    (function () {
      if (window.innerWidth > 860) return;
      var nav = document.querySelector('header.site nav');
      if (!nav) return;
      var cur = nav.querySelector('a.active');
      if (!cur) return;
      /* offsetLeft is measured against the nearest positioned ancestor, which is
         not this strip — using it put the active link half off the left edge.
         Actual rectangles say where things really are. */
      var navBox = nav.getBoundingClientRect();
      var curBox = cur.getBoundingClientRect();
      var delta = (curBox.left - navBox.left) - (navBox.width - curBox.width) / 2;
      nav.scrollLeft = nav.scrollLeft + delta;
    })();
  </script>

  <div id="consent" style="display:none; position:fixed; bottom:14px; left:14px; right:14px; max-width:560px;
    margin:0 auto; background:var(--panel); border:1px solid var(--panel2); border-radius:14px;
    padding:16px 18px; z-index:60; box-shadow:0 10px 40px rgba(0,0,0,.4);">
    <div style="font-size:14.5px; line-height:1.55;">
      We'd like to use Google Analytics to see which pages people actually use.
      It sets cookies. Decline and everything still works — we keep only anonymous,
      cookieless counts either way.
    </div>
    <div style="display:flex; gap:8px; margin-top:12px; flex-wrap:wrap;">
      <button class="btn" id="consent-yes">Allow</button>
      <button id="consent-no" style="background:var(--panel2); color:var(--text); border:0;
        border-radius:10px; padding:10px 20px; font:inherit; font-weight:600; cursor:pointer;">Decline</button>
      <a href={`${base}/privacy/`} class="muted" style="align-self:center; font-size:13.5px;">What we collect</a>
    </div>
  </div>

  <style is:global>
    .drawer-link {
      display: block; padding: 9px 10px; border-radius: 8px; color: var(--text);
      font-size: 15.5px; text-decoration: none;
    }
    .drawer-link:hover { background: var(--panel2); text-decoration: none; }
    #drawer.open { right: 0 !important; } /* inline right:-290px sets the resting position */
  </style>
  <script is:inline>
    const drawer = document.getElementById('drawer');
    const overlay = document.getElementById('drawer-overlay');
    const open = (o) => {
      drawer.classList.toggle('open', o);
      overlay.style.display = o ? 'block' : 'none';
    };
    document.getElementById('burger').onclick = () => open(true);
    document.getElementById('drawer-close').onclick = () => open(false);
    overlay.onclick = () => open(false);

    // Consent gate for GA4. Cookieless counting happens regardless.
    const consent = document.getElementById('consent');
    if (!localStorage.getItem('pg_consent')) consent.style.display = 'block';
    document.getElementById('consent-yes').onclick = () => {
      localStorage.setItem('pg_consent', 'yes');
      consent.style.display = 'none';
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-M2PTQLF903';
      document.head.appendChild(s);
      if (window.gtag) { gtag('js', new Date()); gtag('config', 'G-M2PTQLF903'); }
    };
    document.getElementById('consent-no').onclick = () => {
      localStorage.setItem('pg_consent', 'no');
      consent.style.display = 'none';
    };

    const nameEl = document.getElementById('theme-name');
    nameEl.textContent = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
    document.getElementById('theme-toggle').onclick = () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('pg_theme', next);
      nameEl.textContent = next;
    };
  </script>
  <footer class="site">
    PapaGaio — the European Portuguese you actually hear in Portugal. Free forever, no premium tier.
    · <a href={`${base}/privacy/`}>Privacy</a>
    · <a href={`${base}/support/`}>Support</a>

    · Part of <a href="https://azenha.ai">azenha.ai</a>
  </footer>
</body>
</html>
