<script is:inline>
  // One audio element for the whole site, unlocked by the first tap.
  //
  // Every page used to do `new Audio(url).play()` after awaiting the network.
  // On desktop Chrome that works; in Safari, and on every iPhone, the user
  // gesture has expired by the time the fetch returns and play() is refused —
  // silently, as a rejected promise nobody caught. That is the "sometimes it
  // does not play" testers reported: it depended on the browser, not the word.
  //
  // Creating the element inside the gesture and only setting its source later
  // keeps the permission the tap granted.
  (function () {
    var el = null;
    function element() {
      if (!el) el = new Audio();
      return el;
    }
    // The first tap anywhere unlocks it, so even the first Listen has a
    // primed element to hand.
    addEventListener('pointerdown', function once() {
      removeEventListener('pointerdown', once);
      var a = element();
      a.muted = true;
      a.play().catch(function () {}).finally(function () {
        a.pause();
        a.muted = false;
      });
    }, { once: true });

    window.pgPlayUrl = function (url) {
      var a = element();
      a.src = url;
      return a.play().catch(function (e) {
        console.warn('audio refused', e && e.name);
      });
    };

    window.pgSpeak = async function (text, course) {
      var a = element();
      // Claim the element while the gesture is still fresh, then fill it.
      a.play().catch(function () {});
      try {
        var r = await fetch('/api/tts', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ text: text, course: course || 'pt' }),
        });
        if (!r.ok) return;
        a.src = URL.createObjectURL(await r.blob());
        await a.play();
      } catch (e) {
        console.warn('audio refused', e && e.name);
      }
    };
  })();
</script>
<!-- Install prompt — the reference copy, inserted before </body>.
     Source of truth: ~/Projects/_stores/ios-install-hint.html

     One banner, two behaviours, because the platforms differ:

     Android and desktop Chromium fire beforeinstallprompt, so there we show a
     REAL button that opens the system install dialog. The event only arrives
     when the site is installable: a manifest with 192 and 512 icons, display
     standalone, https, and a service worker with a fetch handler. Without the
     worker there is no button at all.

     Safari does not support beforeinstallprompt and never will, and on iOS
     EVERY browser must run on Safari's engine — so Chrome and Firefox behave
     the same there. All that is left is to point at the Share button.

     Shown only when it makes sense: the page is not already running as an app
     and the visitor has not dismissed the hint. The dismissal is remembered in
     localStorage — a banner that returns on every page annoys more than helps.

     iPadOS needs its own check: since version 13 an iPad reports itself as a
     Mac, so a plain /iPad/ userAgent test no longer catches it — we detect it
     by MacIntel reporting touch points. -->
<div id="a2hs" hidden>
  <p id="a2hs-text"></p>
  <button type="button" id="a2hs-go" hidden>Install</button>
  <button type="button" id="a2hs-x" aria-label="Dismiss">&times;</button>
</div>
<style>
  #a2hs{position:fixed;left:12px;right:12px;bottom:12px;z-index:9999;
    display:flex;align-items:center;gap:10px;padding:12px 14px;
    border-radius:12px;border:1px solid rgba(255,255,255,.18);
    background:rgba(20,26,22,.94);color:#f2f5f3;
    font:14px/1.35 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    box-shadow:0 6px 24px rgba(0,0,0,.35);
    /* The home bar on button-less iPhones covers the bottom 34pt. */
    margin-bottom:env(safe-area-inset-bottom,0)}
  @media (max-width:760px){#a2hs{bottom:calc(12px + 62px)}}
  #a2hs[hidden]{display:none}
  #a2hs p{margin:0;flex:1}
  #a2hs strong{white-space:nowrap}
  #a2hs button{flex:none;border:0;border-radius:8px;color:inherit;cursor:pointer;
    font:inherit;background:rgba(255,255,255,.12)}
  #a2hs-go{padding:7px 14px;font-weight:600;background:#2f7d5d;color:#fff}
  #a2hs-go[hidden]{display:none}
  #a2hs-x{width:28px;height:28px;font-size:18px;line-height:1}
</style>
<script>
  (function () {
    var el = document.getElementById('a2hs');
    if (!el) return;
    var txt = document.getElementById('a2hs-text');
    var go = document.getElementById('a2hs-go');
    var KEY = 'a2hs-dismissed';

    var dismissed = false;
    try { dismissed = localStorage.getItem(KEY) === '1'; } catch (e) {}
    var installed = window.navigator.standalone === true ||
                    (window.matchMedia &&
                     window.matchMedia('(display-mode: standalone)').matches);
    if (dismissed || installed) return;

    document.getElementById('a2hs-x').addEventListener('click', function () {
      el.hidden = true;
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
    });

    // Android / Chromium: a real install.
    var deferred = null;
    window.addEventListener('beforeinstallprompt', function (e) {
      e.preventDefault();
      deferred = e;
      txt.textContent = 'Install this as an app — it opens full-screen, without a browser bar.';
      go.hidden = false;
      el.hidden = false;
    });
    go.addEventListener('click', function () {
      if (!deferred) return;
      deferred.prompt();
      deferred.userChoice.then(function () {
        el.hidden = true;
        try { localStorage.setItem(KEY, '1'); } catch (e) {}
      });
      deferred = null;
    });
    window.addEventListener('appinstalled', function () {
      el.hidden = true;
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
    });

    // iOS: no button exists, so point the way to it.
    var ua = navigator.userAgent;
    // The iPad test (a "Mac" with touch points) also matched Android phones
    // in some emulators, which then got the App Store offer; Android is ruled
    // out by name.
    var iOS = !/Android/.test(ua) && (/iPhone|iPod|iPad/.test(ua) ||
              (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1));
    // iPhone and iPad: the real app is in the App Store, so that is what the
    // hint offers — a home-screen shortcut to the site is the lesser thing.
    // Safari also shows its own banner (apple-itunes-app above); Chrome and
    // Firefox on iOS do not, and this covers them.
    if (iOS) {
      txt.innerHTML = '<strong>PapaGaio</strong> is in the App Store — free, ' +
                      'with the dictionary offline.';
      go.textContent = 'Get the app';
      go.hidden = false;
      go.onclick = function () {
        location.href = 'https://apps.apple.com/app/id6802084974';
      };
      // Not immediately: a hint in the first second reads as an ad.
      setTimeout(function () { el.hidden = false; }, 2500);
    }
  })();
</script>
  <script is:inline>
    // Without a worker with a fetch handler Chrome does not treat the
    // site as an app and shows no install button.
    if ('serviceWorker' in navigator) addEventListener('load', function () {
      navigator.serviceWorker.register('/papagaio/sw.js', { scope: '/papagaio/' })
        .catch(function () {});
    });
  </script>
</body>
