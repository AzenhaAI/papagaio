  <script>
    // One pass over the static text: [data-t] elements swap their text, [data-tp]
    // their placeholder and [data-ta] their aria-label/title, keyed by the
    // English. An empty attribute means "the English is what is written there";
    // data-tn fills a {n} in the string. English pages are left exactly as built.
    import { UI, ui, setUi, t } from '../lib/i18n.js';

    window.pgT = t;
    const lang = ui();
    const norm = (s) => String(s || '').replace(/\s+/g, ' ').trim();
    if (lang !== 'en') {
      document.querySelectorAll('[data-t]').forEach((el) => {
        let s = t(el.getAttribute('data-t') || norm(el.textContent));
        if (el.dataset.tn != null) s = s.replace('{n}', el.dataset.tn);
        el.textContent = s;
      });
      document.querySelectorAll('[data-tp]').forEach((el) => {
        el.placeholder = t(el.getAttribute('data-tp') || el.getAttribute('placeholder') || '');
      });
      document.querySelectorAll('[data-ta]').forEach((el) => {
        const key = el.getAttribute('data-ta');
        for (const a of ['aria-label', 'title']) {
          if (el.hasAttribute(a)) el.setAttribute(a, t(key || el.getAttribute(a)));
        }
      });
    }

    document.querySelectorAll('.langpill button').forEach((b) => {
      const on = b.dataset.ui === lang;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
      b.onclick = () => {
        if (on || !UI.includes(b.dataset.ui)) return;
        setUi(b.dataset.ui);
        location.reload();
      };
    });
  </script>
