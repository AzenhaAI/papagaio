---
const { title = 'PapaGaio — European Portuguese translator & tutor', desc = 'Translator and language tutor for European Portuguese (pt-PT), the variant spoken in Portugal and Madeira. Flashcards in Telegram, AI voice coach, zero subscriptions.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- noindex until Kirill reviews the site -->
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <link rel="icon" href={`${base}/icon.svg`} type="image/svg+xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://shpara.com/papagaio/og.png" />
  <meta name="twitter:card" content="summary" />
  <script is:inline>
    // Theme before first paint — no flash.
    const saved = localStorage.getItem('pg_theme');
    if (saved) document.documentElement.dataset.theme = saved;
  </script>
  <style is:global>
    :root {
      --bg: #0e1a14;
      --panel: #16241c;
      --panel2: #1c2e23;
      --text: #e8f2ea;
      --muted: #8fa898;
      --accent: #34d17b;
      --accent2: #ffc857;
      --warn: #ff9d5c;
      --radius: 14px;
      --max: 880px;
    }
    :root[data-theme="light"] {
      --bg: #f4f8f4;
      --panel: #ffffff;
      --panel2: #e9f1ea;
      --text: #14261a;
      --muted: #5b7263;
      --accent: #1f9d58;
      --accent2: #b8860b;
      --warn: #c05621;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; background: var(--bg); color: var(--text);
      font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    header.site {
      max-width: var(--max); margin: 0 auto; padding: 20px 20px 0;
      display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    }
    header.site .logo { font-size: 26px; font-weight: 700; color: var(--text); }
    header.site .logo span { color: var(--accent); }
    header.site nav { display: flex; gap: 18px; margin-left: auto; }
    header.site nav a { color: var(--muted); font-size: 15px; }
    header.site nav a:hover { color: var(--text); text-decoration: none; }
    main { max-width: var(--max); margin: 0 auto; padding: 28px 20px 60px; }
    footer.site {
      max-width: var(--max); margin: 0 auto; padding: 24px 20px 40px;
      color: var(--muted); font-size: 13.5px; border-top: 1px solid var(--panel2);
    }
    .panel { background: var(--panel); border-radius: var(--radius); padding: 22px; }
    .btn {
      display: inline-block; background: var(--accent); color: #08130c;
      font-weight: 600; padding: 10px 20px; border-radius: 10px; border: 0;
      font-size: 16px; cursor: pointer;
    }
    .btn:hover { filter: brightness(1.08); text-decoration: none; }
    .muted { color: var(--muted); }
    h1 { font-size: 30px; line-height: 1.25; margin: 0 0 10px; }
    h2 { font-size: 21px; margin: 34px 0 12px; }
  </style>
</head>
<body>
  <header class="site">
    <a class="logo" href={`${base}/`}>Papa<span>Gaio</span> 🦜</a>
    <nav>
      <a href={`${base}/`}>Translator</a>
      <a href={`${base}/dictionary/`}>Dictionary</a>
      <a href={`${base}/about/`}>About</a>
      <a href="https://t.me/papagaio_bot">Telegram bot</a>
    </nav>
    <button id="burger" aria-label="Menu" style="background:none; border:0; color:var(--text); font-size:24px; cursor:pointer; padding:4px 8px;">☰</button>
  </header>

  <div id="drawer-overlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:40;"></div>
  <aside id="drawer" style="position:fixed; top:0; right:-290px; width:280px; height:100vh; background:var(--panel);
    z-index:50; transition:right .25s ease; padding:22px; display:flex; flex-direction:column; gap:4px; box-shadow:-8px 0 30px rgba(0,0,0,.35);">
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
      <strong style="font-size:18px;">Menu</strong>
      <button id="drawer-close" aria-label="Close" style="background:none; border:0; color:var(--muted); font-size:22px; cursor:pointer;">✕</button>
    </div>
    <a class="drawer-link" href={`${base}/`}>🔤 Translator</a>
    <a class="drawer-link" href={`${base}/dictionary/`}>📖 Dictionary</a>
    <a class="drawer-link" href={`${base}/about/`}>ℹ️ About</a>
    <a class="drawer-link" href="https://t.me/papagaio_bot">🦜 Telegram bot</a>
    <hr style="border:0; border-top:1px solid var(--panel2); margin:10px 0;" />
    <button id="theme-toggle" class="drawer-link" style="background:none; border:0; font:inherit; text-align:left; cursor:pointer; width:100%;">🌗 Theme: <span id="theme-name">dark</span></button>
    <hr style="border:0; border-top:1px solid var(--panel2); margin:10px 0;" />
    <a class="drawer-link" href="https://github.com/kirshp/papagaio">⭐ GitHub</a>
    <a class="drawer-link" href="mailto:aurapark888@gmail.com">✉️ Contact</a>
    <hr style="border:0; border-top:1px solid var(--panel2); margin:10px 0;" />
    <span class="drawer-link muted" style="cursor:default;">🤖 Android app — soon</span>
    <span class="drawer-link muted" style="cursor:default;">🍎 iOS app — soon</span>
  </aside>
  <main><slot /></main>
  <style is:global>
    .drawer-link {
      display: block; padding: 9px 10px; border-radius: 8px; color: var(--text);
      font-size: 15.5px; text-decoration: none;
    }
    .drawer-link:hover { background: var(--panel2); text-decoration: none; }
    #drawer.open { right: 0 !important; } /* inline right:-290px sets the resting position */
    @media (max-width: 720px) { header.site nav { display: none; } }
  </style>
  <script is:inline>
    const drawer = document.getElementById('drawer');
    const overlay = document.getElementById('drawer-overlay');
    const open = (o) => {
      drawer.classList.toggle('open', o);
      overlay.style.display = o ? 'block' : 'none';
    };
    document.getElementById('burger').onclick = () => open(true);
    document.getElementById('drawer-close').onclick = () => open(false);
    overlay.onclick = () => open(false);

    const nameEl = document.getElementById('theme-name');
    nameEl.textContent = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
    document.getElementById('theme-toggle').onclick = () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('pg_theme', next);
      nameEl.textContent = next;
    };
  </script>
  <footer class="site">
    PapaGaio — the European Portuguese you actually hear in Portugal. Free forever, no premium tier.
    · <a href={`${base}/privacy/`}>Privacy</a>
    · <a href="https://github.com/kirshp/papagaio">Source on GitHub</a>
    · Part of <a href="https://shpara.com">shpara.com</a>
  </footer>
</body>
</html>
