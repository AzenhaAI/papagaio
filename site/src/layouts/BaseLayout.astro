---
const { title = 'PapaGaio', desc = 'A live AI conversation coach for European Portuguese (pt-PT): roleplay the caf\u00e9, the bank, AIMA — it hears you, talks back and corrects you. Plus a pt-PT translator, reader and flashcards. Free forever.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), 'https://azenha.ai').href;
// The current section lights up in the nav — computed at build time from the
// page's own path, so every page gets it for free.
const here = Astro.url.pathname.replace(/\/$/, '');
const active = (p) => here.endsWith(`/${p}`) ? 'active' : '';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <script is:inline>
    // Safari with storage blocked, and some old in-app browsers, throw on any
    // localStorage access; a page that reads its token or theme first then
    // dies before it draws anything. Behind this, every page gets a working
    // (if forgetful) store instead of an exception.
    (function () {
      try { var k = '__pg'; localStorage.setItem(k, k); localStorage.removeItem(k); }
      catch (e) {
        var m = {};
        try {
          Object.defineProperty(window, 'localStorage', { configurable: true, value: {
            getItem: function (k) { return k in m ? m[k] : null; },
            setItem: function (k, v) { m[k] = String(v); },
            removeItem: function (k) { delete m[k]; },
            clear: function () { m = {}; },
            key: function (i) { return Object.keys(m)[i] || null; },
            get length() { return Object.keys(m).length; },
          } });
        } catch (e2) {}
      }
      // AbortSignal.timeout arrived in Safari 16; the coach needs it.
      if (window.AbortController && window.AbortSignal && !AbortSignal.timeout) {
        AbortSignal.timeout = function (ms) {
          var c = new AbortController(); setTimeout(function () { c.abort(); }, ms); return c.signal;
        };
      }
    })();
    // The interface language, EN · PT · RU: the pill in the header writes
    // pg_ui; without one the browser's language decides. src/lib/i18n.js has
    // the same rule for the page scripts — keep the two in step. Every request
    // to the worker that writes words for a reader (translations, the coach,
    // photo reading, dictionary articles) carries it, so a Russian reader gets
    // Russian glosses without each page having to remember to ask.
    (function () {
      function pgUi() {
        try {
          var v = localStorage.getItem('pg_ui');
          if (v === 'en' || v === 'pt' || v === 'ru') return v;
        } catch (e) {}
        var n = String(navigator.language || '').toLowerCase();
        return n.indexOf('ru') === 0 ? 'ru' : n.indexOf('pt') === 0 ? 'pt' : 'en';
      }
      window.pgUi = pgUi;
      try { document.documentElement.lang = pgUi() === 'pt' ? 'pt-PT' : pgUi(); } catch (e) {}
      if (!window.fetch) return;
      var real = window.fetch;
      var BODY = /^\/api\/(translate|vision|coach)(\/|$)/;
      var QUERY = /^\/api\/(lookup$|entry\/)/;
      window.fetch = function (input, init) {
        try {
          var isReq = typeof Request !== 'undefined' && input instanceof Request;
          var u = new URL(typeof input === 'string' ? input : isReq ? input.url : String(input), location.href);
          if (u.origin === location.origin) {
            var method = String((init && init.method) || (isReq && input.method) || 'GET').toUpperCase();
            if (BODY.test(u.pathname) && init && typeof init.body === 'string') {
              var d = JSON.parse(init.body);
              if (d && typeof d === 'object' && !Array.isArray(d) && !('ui' in d)) {
                d.ui = pgUi();
                init = Object.assign({}, init, { body: JSON.stringify(d) });
              }
            } else if (QUERY.test(u.pathname) && method === 'GET' && !u.searchParams.has('ui')) {
              u.searchParams.set('ui', pgUi());
              input = isReq ? new Request(u.href, input) : u.href;
            }
          }
        } catch (e) { /* not JSON, or an odd input: send it as it was */ }
        return real.call(window, input, init);
      };
    })();
    // When the server's voice fails, the device speaks instead. The server
    // uses Microsoft Edge's online voices, and on 10 Oct 2026 Microsoft
    // started refusing every third-party client (edge-tts included) with 403.
    // Pages ask /api/tts in seven places; this answers all of them: on any
    // failure the phrase goes to the browser's own speech (Joana pt-PT on
    // Apple devices, Google's pt-PT voice on Android) and the page gets a
    // moment of silence back, so it neither reports "audio failed" nor stalls
    // the coach's turn.
    (function () {
      if (!window.fetch || !window.speechSynthesis || !window.SpeechSynthesisUtterance) return;
      var real = window.fetch.bind(window);
      function silence() {
        var b = new Uint8Array(46), v = new DataView(b.buffer);
        [82,73,70,70].forEach(function (c, i) { b[i] = c; }); v.setUint32(4, 38, true);
        [87,65,86,69,102,109,116,32].forEach(function (c, i) { b[8 + i] = c; });
        v.setUint32(16, 16, true); v.setUint16(20, 1, true); v.setUint16(22, 1, true);
        v.setUint32(24, 8000, true); v.setUint32(28, 8000, true); v.setUint16(32, 1, true); v.setUint16(34, 8, true);
        [100,97,116,97].forEach(function (c, i) { b[36 + i] = c; }); v.setUint32(40, 2, true); b[44] = 128; b[45] = 128;
        return new Response(new Blob([b], { type: 'audio/wav' }), { status: 200, headers: { 'content-type': 'audio/wav' } });
      }
      function say(body) {
        try {
          var d = JSON.parse(body || '{}'), lang = d.course === 'en' ? 'en-GB' : 'pt-PT';
          if (!d.text) return false;
          var u = new SpeechSynthesisUtterance(d.text);
          u.lang = lang; u.rate = 0.95;
          var vs = speechSynthesis.getVoices().filter(function (x) { return x.lang && x.lang.replace('_', '-').indexOf(lang) === 0; });
          if (vs.length) u.voice = vs[0];
          speechSynthesis.cancel(); speechSynthesis.speak(u);
          return true;
        } catch (e) { return false; }
      }
      window.fetch = function (input, init) {
        var url = typeof input === 'string' ? input : (input && input.url) || '';
        if (!/\/api\/tts(\?|$)/.test(url)) return real(input, init);
        var body = init && init.body;
        return real(input, init).then(function (r) {
          if (r.ok) return r;
          return say(body) ? silence() : r;
        }, function (e) {
          if (say(body)) return silence();
          throw e;
        });
      };
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={`${base}/icon.svg`} type="image/svg+xml" />
  <!-- Safari and the iOS home screen ignore SVG favicons; without these
       the tab falls back to a blank page glyph. -->
  <link rel="icon" href={`${base}/icon-32.png`} sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <!-- Added to a home screen, the shortcut is named from the manifest.
       Without one Chrome falls back to the page title, which is how a
       tab called "Translate into European Portuguese" ended up as an
       icon label. short_name is the only string that fits under one. -->
  <link rel="manifest" href={`${base}/manifest.webmanifest`} />
  <meta name="theme-color" content="#0e1a14" />
  <meta name="apple-mobile-web-app-title" content="PapaGaio" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://azenha.ai/papagaio/og.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta property="og:url" content={canonical} />
  {import.meta.env.PROD && (
    <>
      {/* Cloudflare Web Analytics is cookieless and injected by Pages itself —
          enabled per-project in the dashboard, no beacon tag needed here. */}
      {/* GA4 stays parked behind consent: EU visitors must opt in first. */}
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        if (localStorage.getItem('pg_consent') === 'yes') {
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-M2PTQLF903';
          document.head.appendChild(s);
          gtag('js', new Date());
          gtag('config', 'G-M2PTQLF903');
        }
      </script>
    </>
  )}
  <script is:inline>
    // One way in for a /link code, used by every page that has a code box.
    // The code is checked before anything is stored: a typo used to overwrite
    // the browser's own account and, on the next 401, delete it for good. The
    // account it replaces is kept under pg_token_prev, so nothing studied here
    // is ever unreachable.
    window.pgUseCode = function (code) {
      code = String(code || '').trim();
      var cur = null;
      try { cur = localStorage.getItem('pg_token'); } catch (e) {}
      if (!code) return Promise.resolve({ ok: false, msg: 'Paste the code first.' });
      if (code === cur) return Promise.resolve({ ok: true, msg: 'Already connected with this code.' });
      return fetch('/api/stats', { headers: { 'x-device-token': code } }).then(function (r) {
        if (r.status === 401 || r.status === 403 || r.status === 404) return { ok: false, msg: 'That code did not work — check it and try again. Nothing was changed.' };
        if (!r.ok) return { ok: false, msg: 'The server is not answering right now — try again in a minute. Nothing was changed.' };
        if (cur && !confirm('Switch this browser to that account? What you practised here so far stays on the server under the old account.')) return { ok: false, msg: '' };
        try {
          if (cur) localStorage.setItem('pg_token_prev', cur);
          localStorage.setItem('pg_token', code);
        } catch (e) {}
        return { ok: true, msg: 'Connected.' };
      }, function () {
        return { ok: false, msg: navigator.onLine ? 'The server is not answering right now — try again in a minute. Nothing was changed.' : 'No connection — try again when you are online. Nothing was changed.' };
      });
    };
  </script>
  <script is:inline>
    // Theme before first paint — no flash.
    // A theme chosen in Settings wins; otherwise the device's own setting.
    const saved = localStorage.getItem('pg_theme');
    if (saved) document.documentElement.dataset.theme = saved;
    else if (window.matchMedia && matchMedia('(prefers-color-scheme: light)').matches) document.documentElement.dataset.theme = 'light';
  </script>
  <style is:global>
    /* Portuguese flag palette: green and red, with the flag's own gold between them. */
    :root {
      --bg: #0e1a14;
      --panel: #16241c;
      --panel2: #1c2e23;
      --text: #e8f2ea;
      --muted: #8fa898;
      --accent: #34d17b;
      --accent2: #ffc857;
      --red: #e8453c;
      --warn: #ff9d5c;
      --border: #2a4433;
      --radius: 14px;
      --max: 880px;
    }
    :root[data-theme="light"] {
      --bg: #f4f8f4;
      --panel: #ffffff;
      --panel2: #e9f1ea;
      --text: #14261a;
      --muted: #5b7263;
      --accent: #157a43;
      --accent2: #8a6508;
      --red: #c8102e;
      --warn: #c05621;
      --border: #c9d8cc;
    }
    /* The flag's own 2:3 proportion, as a hairline across the top. */
    body::before {
      content: '';
      position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 70;
      background: linear-gradient(to right, var(--accent) 0 40%, var(--red) 40% 100%);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; background: var(--bg); color: var(--text);
      font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    header.site {
      max-width: var(--max); margin: 0 auto; padding: 20px 20px 0;
      display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    }
    header.site .logo { font-size: 26px; font-weight: 700; color: var(--accent); }
    header.site .logo span { color: var(--red); }
    /* Centred, not stretched: without this the plain links sit at the top of
       their full-height boxes while the padded pill centres inside its own,
       and the row reads as if one item slipped. */
    header.site nav { display: flex; align-items: center; gap: 18px; margin-left: auto; }
    header.site nav a { color: var(--muted); font-size: 15px; white-space: nowrap; }
    header.site nav a:hover { color: var(--text); text-decoration: none; }
    header.site nav a.active {
      color: var(--text); font-weight: 600;
      border-bottom: 2px solid var(--accent); padding-bottom: 2px;
    }
    header.site { flex-wrap: nowrap; }
    /* Eight links do not fit a phone side by side, but hiding them outright left
       the header empty and every section a tap away behind the burger. They stay,
       as a strip that scrolls sideways and fades out before the burger; the burger
       keeps the full list, including what the strip has no room for. */
    @media (max-width: 860px) {
      header.site { flex-wrap: nowrap; gap: 10px; }
      header.site nav {
        margin-left: 0; align-items: center;
        flex: 1 1 auto; min-width: 0; gap: 14px;
        overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
        -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 26px), transparent 100%);
                mask-image: linear-gradient(to right, #000 calc(100% - 26px), transparent 100%);
      }
      header.site nav::-webkit-scrollbar { display: none; }
      header.site nav a { font-size: 14px; }
      header.site .logo { font-size: 21px; flex: 0 0 auto; }
      header.site #burger { margin-left: 0; flex: 0 0 auto; }
    }
    header.site #burger { margin-left: 4px; }
    /* Listen buttons were a bare 🔊 glyph, 20-26px across: under a thumb on a
       phone they were easy to miss. 40px is the floor, whatever the page. */
    button.say, button.exspeak, button.speak,
    button[onclick*="pgPlayUrl"], button[onclick*="playTts"] {
      min-width: 40px; min-height: 40px;
      display: inline-flex; align-items: center; justify-content: center;
    }
    .pg-tabbar { display: none; }
    /* One prompt at a time: three cards stacked over a 320-point screen read as
       a wall. While the consent card is up, the install prompts wait. */
    body:has(#consent[style*="block"]) #az-apk,
    body:has(#consent[style*="block"]) #a2hs { display: none !important; }
    /* Phones: the six sections move from the header strip to the bar, so
       nothing is listed twice; the logo, Get the app and the burger stay. */
    @media (max-width: 760px) {
      header.site nav a:not(.getapp-pill) { display: none; }
      header.site nav { -webkit-mask-image: none; mask-image: none; justify-content: flex-end; }
      body { padding-bottom: calc(62px + env(safe-area-inset-bottom)); }
      .pg-tabbar {
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
        display: flex; align-items: stretch;
        height: calc(62px + env(safe-area-inset-bottom));
        padding-bottom: env(safe-area-inset-bottom);
        background: var(--panel); border-top: 1px solid var(--panel2);
        box-shadow: 0 -4px 16px rgba(0,0,0,.18);
      }
      .pg-tabbar a {
        flex: 1 1 0; min-width: 0;
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
        color: var(--muted); font-size: 10.5px; font-weight: 600; text-decoration: none;
      }
      .pg-tabbar a span { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .pg-tabbar a svg { width: 22px; height: 22px; box-sizing: content-box; fill: currentColor; padding: 3px 10px; border-radius: 14px; }
      .pg-tabbar a.on { color: var(--accent); }
      .pg-tabbar a.on svg { background: rgba(52,209,123,.16); background: color-mix(in srgb, var(--accent) 16%, transparent); }
      .pg-tabbar a:hover { text-decoration: none; }
      /* What floats at the bottom of a page sits above the bar. */
      #consent { bottom: calc(14px + 62px + env(safe-area-inset-bottom)) !important; }
      /* azenha.ai's own "Get the app for Android" strip (added by the site's
         middleware) sits above the bar, not over it. */
      #az-apk { bottom: calc(62px + env(safe-area-inset-bottom)) !important; }
      /* The menu is taller than a phone: it scrolls, and dvh keeps Safari's
         toolbars from cutting its end off. */
      #drawer { height: calc(100vh - 62px - env(safe-area-inset-bottom)) !important; }
      @supports (height: 100dvh) { #drawer { height: calc(100dvh - 62px - env(safe-area-inset-bottom)) !important; } }
    }
    /* The narrowest phones (iPhone SE, 320 pt): all six, labels a touch smaller. */
    @media (max-width: 360px) { .pg-tabbar a { font-size: 9.5px; } .pg-tabbar a svg { padding: 3px 8px; } }
    main { max-width: var(--max); margin: 0 auto; padding: 28px 20px 60px; }
    .intro-fold { margin: 0 0 18px; }
    .intro-fold > summary {
      cursor: pointer; list-style: none; color: var(--muted); font-size: 14px;
      padding: 7px 0; border-bottom: 1px solid var(--panel2);
    }
    .intro-fold > summary::-webkit-details-marker { display: none; }
    .intro-fold > summary::after { content: ' ▾'; }
    .intro-fold[open] > summary::after { content: ' ▴'; }
    .intro-fold[open] > summary { margin-bottom: 10px; }
    footer.site {
      max-width: var(--max); margin: 0 auto; padding: 24px 20px 40px;
      color: var(--muted); font-size: 13.5px; border-top: 1px solid var(--panel2);
    }
    .panel { background: var(--panel); border-radius: var(--radius); padding: 22px; }
    .btn {
      display: inline-block; background: var(--accent); color: #08130c;
      font-weight: 600; padding: 10px 20px; border-radius: 10px; border: 0;
      font-size: 16px; cursor: pointer;
    }
    .btn:hover { filter: brightness(1.08); text-decoration: none; }
    .muted { color: var(--muted); }
    h1 { font-size: 30px; line-height: 1.25; margin: 0 0 10px; }
    h2 { font-size: 21px; margin: 34px 0 12px; }
  </style>
    <!-- Smart App Banner: Safari's own strip at the top, "Open" or "Get" for
         the App Store app. The listing is public since 16 August 2026. -->
    <meta name="apple-itunes-app" content="app-id=6802084974" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
  <style is:global>
    .getapp-pill { display: inline-flex; align-items: center; gap: 6px;
      border: 1px solid var(--border); border-radius: 999px;
      padding: 6px 12px; font-size: 13px; line-height: 1; white-space: nowrap; }
    .getapp-pill:hover { border-color: var(--accent); }
    .langpill {
      display: inline-flex; flex: 0 0 auto; padding: 3px; gap: 0;
      background: var(--panel); border: 1px solid var(--border); border-radius: 999px;
    }
    .langpill button {
      min-width: 40px; min-height: 34px; padding: 0 8px;
      background: none; border: 0; border-radius: 999px; cursor: pointer;
      color: var(--muted); font: inherit; font-size: 13px; font-weight: 600; line-height: 1;
    }
    .langpill button:hover { color: var(--text); }
    .langpill button.on { background: var(--accent); color: #08130c; cursor: default; }
    /* A phone has room for the logo, the pill and the burger: "Get the app"
       shrinks to its icon, and on the narrowest screens it lives only in the
       menu (Apps), where it always was too. */
    /* Desktop: seven links, the get-the-app pill, the language pill and the
       burger did not fit the 880 px column even in English. The header gets
       a little more width than the text column, and if the row still does
       not fit (Russian labels are longer) the links scroll sideways as they
       do on a tablet instead of pushing the burger off the screen. (:root because
       this block lands before the base header rules in the built CSS.) Outside
       English the get-the-app pill is its icon; the burger lists Apps too. */
    @media (min-width: 861px) {
      :root header.site { max-width: calc(var(--max) + 200px); }
      :root header.site nav {
        flex: 0 1 auto; min-width: 0; padding: 4px 0;
        overflow-x: auto; scrollbar-width: none;
      }
      :root header.site nav::-webkit-scrollbar { display: none; }
      :root:not([lang="en"]) header.site .getapp-pill .gl { display: none; }
    }
    @media (max-width: 760px) {
      :root header.site .getapp-pill .gl { display: none; }
      :root header.site #burger { padding: 4px 6px !important; }
    }
    @media (max-width: 400px) {
      :root header.site { padding-left: 14px; padding-right: 14px; gap: 6px !important; }
      :root header.site .getapp-pill { display: none; }
    }
  </style>
</head>
<body>
  <!-- Shown only without a connection: says why things are quiet instead of
       leaving panels that look broken. -->
  <div id="pg-offline" hidden style="position:sticky; top:3px; z-index:65; background:var(--warn); color:#1a1205;
       font-size:13.5px; font-weight:600; text-align:center; padding:6px 12px;">
    <span data-t>No connection — pages and words you opened before still work.</span>
  </div>
  <script is:inline>
    (function () {
      var bar = document.getElementById('pg-offline');
      function paint() { bar.hidden = navigator.onLine !== false; }
      window.addEventListener('online', paint);
      window.addEventListener('offline', paint);
      paint();
    })();
  </script>
  <header class="site">
    <a class="logo" href={`${base}/`}>Papa<span>Gaio</span></a>
    <nav>
      <!-- The same six the app puts along its bottom, and nothing else. Ten
           links stretched the header across the window and read as a list;
           what does not belong here lives in the burger and as chips on the
           cards page, exactly as in the app. -->
      <a class={active('coach')} href={`${base}/coach/`} data-t>AI Coach</a>
      <a class={active('practice')} href={`${base}/practice/`} data-t>Cards</a>
      <a class={active('translate')} href={`${base}/translate/`} data-t>Translate</a>
      <a class={active('dictionary')} href={`${base}/dictionary/`} data-t>Dictionary</a>
      <a class={active('verbs')} href={`${base}/verbs/`} data-t>Verbs</a>
      <a class={active('progress')} href={`${base}/progress/`} data-t>Progress</a>
      <a class={active('settings')} href={`${base}/settings/`} data-t>Settings</a>
      <a class="getapp-pill" href={`${base}/apps/`}>📱 <span class="gl" data-t>Get the app</span></a>
    </nav>
    <!-- The interface language, the app's own pill (lib/theme.dart _LangChips):
         one pill, segments at least 40×34, the active one filled. It sits
         after the nav on desktop and beside the burger on a phone. -->
    <div class="langpill" role="group" aria-label="Interface language" data-ta>
      <button type="button" data-ui="en">EN</button><button type="button" data-ui="pt">PT</button><button type="button" data-ui="ru">RU</button>
    </div>
    <button id="burger" aria-label="Menu" data-ta style="background:none; border:0; color:var(--text); font-size:24px; cursor:pointer; padding:4px 8px;">☰</button>
  </header>
  <!-- The bottom tab bar on phones: the app's own bar, same six places, same
       order, same icons, so someone who uses both never looks for anything.
       Madeira Ativa's mobile site does the same. Desktop keeps the top row. -->
  <nav class="pg-tabbar" aria-label="Sections">
    {[
